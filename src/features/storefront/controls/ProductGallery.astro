---
import type { StorefrontGalleryImage, StorefrontImage } from '../models';
import StoreImage from './StoreImage.astro';

/**
 * The product hero: a snap-scrolling gallery when there is more than one image,
 * a single image otherwise.
 *
 * Owns the anchor ids the thumbnails and the variant selector scroll to, and
 * the LCP treatment on the first frame — eager and high priority, with every
 * later frame lazy. Both are easy to lose when restyling and invisible when
 * they go missing.
 *
 * The priority frame is never faded, for the same reason StoreImage refuses the
 * combination: an opacity:0 element is not a valid LCP candidate, so fading it
 * holds the paint back until load and undoes the head start `priority` bought.
 */
interface Props {
  images: StorefrontGalleryImage[];
  hero: StorefrontImage;
  soldOut: boolean;
  soldOutLabel?: string;
  navigation?: 'en' | 'zh-CN';
  class?: string;
}

const {
  images,
  hero,
  soldOut,
  soldOutLabel = 'Sold out',
  navigation,
  class: className = '',
} = Astro.props;
const hasGallery = images.length > 1;
const zh = navigation === 'zh-CN';
---

{
  hasGallery ? (
    <div class={className} data-linked-gallery={navigation ? '' : undefined}>
      <div class:list={[navigation && 'gallery-stage']}>
        <div
          data-hero-track
          class="no-scrollbar relative flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-lg bg-surface"
        >
          {images.map((image) => (
            <figure class="m-0 w-full shrink-0 snap-center">
            <img
              id={`pi-${image.anchor}`}
              src={image.hero.src}
              srcset={image.hero.srcset}
              sizes={image.hero.sizes}
              alt={image.hero.alt}
              title={image.hero.title}
              width="800"
              height="800"
              loading={image.hero.priority ? 'eager' : 'lazy'}
              fetchpriority={image.hero.priority ? 'high' : 'auto'}
              decoding="async"
              {...(image.hero.priority ? {} : { 'data-image-fade': '' })}
              class:list={['aspect-square w-full bg-surface', navigation ? 'object-contain' : 'object-cover', soldOut && 'opacity-60']}
            />
            {image.hero.caption && <figcaption class="px-3 py-2 text-sm text-muted">{image.hero.caption}</figcaption>}
            </figure>
          ))}
          {soldOut && (
            <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-3 py-1 text-xs uppercase tracking-widest text-muted ring-1 ring-line">
              {soldOutLabel}
            </span>
          )}
        </div>
        {navigation && (
          <div class="gallery-controls" data-gallery-controls hidden>
            <button type="button" class="gallery-prev" data-gallery-prev aria-label={zh ? '上一张图片' : 'Previous image'}><span aria-hidden="true">‹</span></button>
            <button type="button" class="gallery-next" data-gallery-next aria-label={zh ? '下一张图片' : 'Next image'}><span aria-hidden="true">›</span></button>
            <span class="gallery-counter" data-gallery-counter>{1} / {images.length}</span>
          </div>
        )}
      </div>
      <div class:list={['mt-3 gap-2', navigation ? 'gallery-thumbs' : 'no-scrollbar flex overflow-x-auto']} data-gallery-thumbs={navigation ? '' : undefined}>
        {images.map((image, index) => (
          <a
            href={`#pi-${image.anchor}`}
            aria-label={zh ? `查看图片 ${index + 1}：${image.hero.alt}` : `View image ${index + 1}: ${image.hero.alt}`}
            aria-current={navigation && index === 0 ? 'true' : undefined}
            class="shrink-0 overflow-hidden rounded border border-line bg-surface transition hover:border-brand"
          >
            <img
              src={image.thumbnail.src}
              srcset={image.thumbnail.srcset}
              sizes={navigation && image.thumbnail.srcset ? '(min-width: 76rem) 6.75rem, (min-width: 48rem) 9vw, 18vw' : image.thumbnail.sizes}
              alt=""
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
              data-image-fade
              class="h-16 w-16 bg-surface object-cover"
            />
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class={`${className} relative overflow-hidden rounded-lg bg-surface`.trim()}>
      <StoreImage
        image={hero}
        fade
        class={`aspect-square w-full bg-surface ${navigation ? 'object-contain' : 'object-cover'}${soldOut ? ' opacity-60' : ''}`}
      />
      {hero.caption && <p class="px-3 py-2 text-sm text-muted">{hero.caption}</p>}
      {soldOut && (
        <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-3 py-1 text-xs uppercase tracking-widest text-muted ring-1 ring-line">
          {soldOutLabel}
        </span>
      )}
    </div>
  )
}

<style>
  [data-linked-gallery]{min-width:0;}
  .gallery-stage,.gallery-thumbs{position:relative;}
  .gallery-controls button,.gallery-counter{position:absolute;background:rgba(8,38,37,.88);color:white;border-radius:999px;}
  .gallery-controls button{display:grid;place-items:center;top:50%;width:44px;height:44px;transform:translateY(-50%);font-size:1.65rem;line-height:1;cursor:pointer;}
  .gallery-controls button[aria-disabled=true]{opacity:.45;cursor:default;}
  .gallery-prev{inset-inline-start:.55rem;}
  .gallery-next{inset-inline-end:.55rem;}
  .gallery-counter{bottom:.6rem;inset-inline-end:.6rem;padding:.2rem .55rem;font-size:.75rem;font-variant-numeric:tabular-nums;pointer-events:none;}
  .gallery-thumbs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));}
  .gallery-thumbs a{border-radius:.5rem;}
  .gallery-thumbs img{display:block;width:100%;height:auto;aspect-ratio:1;}
  .gallery-thumbs a[aria-current=true]{border-color:var(--color-brand);outline:2px solid var(--color-brand);outline-offset:-2px;}
  .gallery-thumbs a:focus-visible{outline:2px solid var(--color-brand);outline-offset:2px;}
  @media(prefers-reduced-motion:reduce){[data-linked-gallery] [data-hero-track]{scroll-behavior:auto;}}
</style>

<script>
  for (const gallery of document.querySelectorAll('[data-linked-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-hero-track]');
    const thumbs = gallery.querySelector<HTMLElement>('[data-gallery-thumbs]');
    const controls = gallery.querySelector<HTMLElement>('[data-gallery-controls]');
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const counter = gallery.querySelector('[data-gallery-counter]');
    if (!track || !thumbs || !controls || !previous || !next || !counter) continue;
    const frames = Array.from(track.querySelectorAll('img'));
    const anchors = Array.from(thumbs.querySelectorAll('a'));
    let current = -1;
    let pending = 0;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    const sync = () => {
      pending = 0;
      const index = Math.min(frames.length - 1, Math.max(0, Math.round(track.scrollLeft / (track.clientWidth || 1))));
      if (index === current) return;
      current = index;
      anchors.forEach((anchor, position) => {
        if (position === current) anchor.setAttribute('aria-current', 'true');
        else anchor.removeAttribute('aria-current');
      });
      previous.setAttribute('aria-disabled', String(current === 0));
      next.setAttribute('aria-disabled', String(current === frames.length - 1));
      counter.textContent = `${current + 1} / ${frames.length}`;
    };

    const show = (index: number) => {
      if (!frames[index]) return;
      track.scrollTo({ left: frames[index].offsetLeft, behavior: reduceMotion.matches ? 'instant' : 'smooth' });
    };
    track.addEventListener('scroll', () => { if (!pending) pending = requestAnimationFrame(sync); }, { passive: true });
    previous.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    anchors.forEach((anchor, index) => anchor.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      show(index);
    }));
    new ResizeObserver(sync).observe(track);
    controls.hidden = false;
    sync();
  }
</script>
