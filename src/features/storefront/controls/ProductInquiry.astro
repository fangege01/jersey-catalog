---
import type { ProductPurchaseModel } from '../models';

interface Props {
  inquiry: NonNullable<ProductPurchaseModel['inquiry']>;
  variantLabel: string | null;
  locale?: import('../../i18n/locale').StoreLocale;
}

const { inquiry, variantLabel, locale } = Astro.props;
const contactClass = 'inline-flex rounded-md bg-brand px-5 py-3 text-sm font-medium text-on-brand hover:bg-brand-hover';
---

<div class="mt-4 space-y-3">
  {inquiry.href ? (
    inquiry.options.length ? (
      <div>
        <p class="mb-2 text-sm font-medium">{variantLabel || (locale === 'zh-CN' ? '规格' : 'Option')}</p>
        <ul class="flex flex-wrap gap-2">
          {inquiry.options.map((option) => (
            <li><a class={contactClass} href={option.href} data-whatsapp-inquiry>
              {locale === 'zh-CN' ? 'WhatsApp 询价' : 'WhatsApp quote'} · {option.label}{option.soldOut ? (locale === 'zh-CN' ? '（缺货）' : ' (sold out)') : ''}
            </a></li>
          ))}
        </ul>
      </div>
    ) : <a class={contactClass} href={inquiry.href} data-whatsapp-inquiry>{locale === 'zh-CN' ? '通过 WhatsApp 询价' : 'Get a quote on WhatsApp'}</a>
  ) : <p class="text-sm text-muted">{locale === 'zh-CN' ? '暂时无法通过 WhatsApp 询价。' : 'WhatsApp inquiries are currently unavailable.'}</p>}
</div>
