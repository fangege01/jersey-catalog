---
import type { ProductPurchaseModel } from '../models';
import { localizedHref } from '../../i18n/locale';

interface Props {
  inquiry: NonNullable<ProductPurchaseModel['inquiry']>;
  variantLabel: string | null;
  locale?: import('../../i18n/locale').StoreLocale;
  compact?: boolean;
}

const { inquiry, variantLabel, locale, compact } = Astro.props;
const zh = locale === 'zh-CN';
const button = 'inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-3 text-center text-sm font-semibold';
---

<div class="mt-4 space-y-3">
  <div class={compact ? 'product-quote-links' : 'grid gap-2 sm:grid-cols-2'}>
    {inquiry.href && <a class={compact ? 'product-quote-link quote-whatsapp' : button + ' bg-brand text-on-brand hover:bg-brand-hover'}
      href={inquiry.href} data-whatsapp-inquiry data-whatsapp-inline={compact ? '' : undefined}>
      {compact && <span class="quote-icon quote-icon-whatsapp" aria-hidden="true"></span>}
      {zh ? '通过 WhatsApp 询价' : 'Get a quote on WhatsApp'}
    </a>}
    {inquiry.emailHref && <a class={compact ? 'product-quote-link quote-email' : button + ' border border-line bg-paper text-ink hover:border-brand'} href={inquiry.emailHref}>
      {compact && <span class="quote-icon quote-icon-email" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
        </svg>
      </span>}
      {zh ? '通过邮件询价' : 'Email for a quote'}
    </a>}
    {!inquiry.href && !inquiry.emailHref && <a class={button + ' bg-brand text-on-brand hover:bg-brand-hover'}
      href={localizedHref('/contact#contact-inquiry', locale ?? 'en')}>
      {zh ? '发送询盘' : 'Send an inquiry'}
    </a>}
  </div>
  {!compact && inquiry.options.length > 0 && <div>
    <p class="mb-2 text-sm font-medium">{variantLabel || (zh ? '规格' : 'Option')}</p>
    <ul class="flex flex-wrap gap-2">
      {inquiry.options.map((option) => (
        <li><a class="inline-flex rounded-md border border-line px-3 py-2 text-sm hover:border-brand"
          href={option.href} data-whatsapp-inquiry aria-label={(zh ? 'WhatsApp 询价：' : 'WhatsApp quote: ') + option.label}>
          {option.label}{option.soldOut ? (zh ? '（缺货）' : ' (sold out)') : ''}
        </a></li>
      ))}
    </ul>
  </div>}
</div>

<style>
  .product-quote-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr));
    gap: .625rem;
  }
  .product-quote-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    min-height: 3.25rem;
    padding: .55rem .75rem;
    border-radius: 999px;
    text-align: center;
    font-size: .875rem;
    font-weight: 750;
    line-height: 1.25;
    transition: background-color .15s;
  }
  .product-quote-link.quote-whatsapp, .product-quote-link.quote-whatsapp:visited {
    background: var(--whatsapp-green);
    color: var(--whatsapp-ink);
    box-shadow: 0 .3rem .85rem rgb(var(--whatsapp-rgb) / .24);
  }
  .product-quote-link.quote-whatsapp:hover { background: var(--whatsapp-hover); }
  .quote-email { background: #1c2e58; color: #fff; }
  .quote-email:hover { background: #293f70; }
  .product-quote-link:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }
  .quote-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
  }
  .quote-icon-whatsapp::before {
    content: '';
    width: 1.125rem;
    height: 1.125rem;
    background: currentColor;
    mask: url('/whatsapp-mark.svg') center / contain no-repeat;
  }
</style>
