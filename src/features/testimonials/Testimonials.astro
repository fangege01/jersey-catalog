---
import { env } from 'cloudflare:workers';
import { display, type StoreLocale } from '../i18n/locale';
import { getConfig } from '../../config';
import { mediaUrl } from '../media/url';
import { publicTestimonials, testimonialSettings } from './db';

interface Props { settings?: string; locale?: StoreLocale }
const { settings, locale } = Astro.props;
const options = testimonialSettings(settings);
const intro = display(locale, options.intro, options.sourceIntro);
const published = options.enabled ? await publicTestimonials(env.DB).catch((error) => {
  console.error('Customer reviews could not be loaded', error);
  return [];
}) : [];
const reviews = published.filter(review => display(locale, review.quote, review.sourceQuote ?? review.quote).trim());
const baseUrl = getConfig().images.baseUrl;
---
{reviews.length > 0 && (
  <section class="reviews" aria-labelledby="customer-reviews">
    <header class="reviews-heading">
      <h2 id="customer-reviews">{display(locale, options.title, options.sourceTitle)}</h2>
      {intro && <p class="reviews-intro">{intro}</p>}
    </header>
    <ul class="reviews-grid" role="list">
      {reviews.map((review) => (
        <li class="review-card">
          {review.rating !== null && <p class="review-rating">
            <span class="review-star" aria-hidden="true"></span>
            <span class="sr-only">{display(locale, 'Rating', '评分')}</span>
            <span>{review.rating.toFixed(1)}</span>
          </p>}
          <blockquote>{display(locale, review.quote, review.sourceQuote ?? review.quote)}</blockquote>
          <div class="review-person">
            {review.avatarKey && <img src={mediaUrl(review.avatarKey, baseUrl)} alt="" loading="lazy" decoding="async" width="44" height="44" />}
            <div>
              <p class="review-name">{review.name}</p>
              {review.attribution && <p class="review-role">{display(locale, review.attribution, review.sourceAttribution ?? review.attribution)}</p>}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .reviews { width: min(calc(100% - 3rem), 75rem); margin-inline: auto; padding-block-end: clamp(1.5rem, 3vw, 2.25rem); }
  .reviews-heading { margin-bottom: 1.3rem; }
  .reviews-heading h2 { margin: 0; font-size: clamp(1.8rem, 3.2vw, 2.65rem); font-weight: 750; color: var(--color-ink); line-height: 1.2; }
  .reviews-intro { max-width: 40rem; margin-top: .75rem; color: var(--color-muted); line-height: 1.65; white-space: pre-wrap; }
  .reviews-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .review-card { display: flex; min-width: 0; flex-direction: column; gap: .9rem; padding: clamp(1rem, 2.2vw, 1.5rem); border: 1px solid var(--color-line); border-radius: 1.25rem; background: linear-gradient(145deg, var(--color-surface), var(--color-paper)); box-shadow: 0 8px 22px rgb(15 118 110 / 6%); overflow-wrap: anywhere; }
  .review-rating { display: flex; align-items: center; gap: .35rem; margin: 0; color: var(--color-brand); font-size: .85rem; font-weight: 750; }
  .review-star {
    flex: none;
    width: 1.25rem;
    aspect-ratio: 1;
    clip-path: polygon(50% 0%,61.8% 33.8%,97.6% 34.5%,69% 56.2%,79.4% 90.5%,50% 70%,20.6% 90.5%,31% 56.2%,2.4% 34.5%,38.2% 33.8%);
    background: conic-gradient(
      #fff4ad 0deg,#efb820 36deg,#fff0a0 36deg,#ffc83c 72deg,
      #c38a08 72deg,#7c4708 108deg,#f2b714 108deg,#fff08b 144deg,
      #f8d05c 144deg,#ad7208 180deg,#7d4a0a 180deg,#cd8f14 216deg,
      #e3a313 216deg,#fff3a1 252deg,#ae7005 252deg,#db9a0e 288deg,
      #fff08b 288deg,#edac16 324deg,#d59a0a 324deg,#ffd74a 360deg
    );
  }
  @media (forced-colors: active) {
    .review-star { forced-color-adjust: none; background: CanvasText; }
  }
  blockquote { flex: 1; margin: 0; color: var(--color-ink); font-size: .95rem; line-height: 1.7; white-space: pre-line; }
  .review-person { display: flex; align-items: center; gap: .7rem; padding-top: .85rem; border-top: 1px solid var(--color-line); }
  .review-person img { flex: none; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .review-name { margin: 0; color: var(--color-ink); font-size: .9rem; font-weight: 750; }
  .review-role { margin: .15rem 0 0; color: var(--color-muted); font-size: .8rem; line-height: 1.35; }
  @media (max-width: 65rem) { .reviews-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 47rem) { .reviews { width: calc(100% - 2rem); } }
  @media (max-width: 38rem) { .reviews-grid { grid-template-columns: 1fr; gap: .75rem; } }
</style>
