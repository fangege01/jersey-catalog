---
import type { SiteCopy } from './copy';
import { localizedHref, type StoreLocale } from '../i18n/locale';

interface Props { copy: SiteCopy<'contact'>; locale: StoreLocale; whatsappHref: string | null }
const { copy, locale, whatsappHref } = Astro.props;
const button = 'group grid justify-items-center gap-1.5 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4';
const circle = 'contact-icon grid size-11 place-items-center rounded-full text-white ring-2 ring-white/90 shadow-lg sm:size-14';
const label = 'rounded-full border border-line bg-surface px-2 py-1 text-[0.65rem] leading-tight font-semibold text-ink shadow-sm sm:text-xs';
---
<nav aria-label={locale === 'zh-CN' ? '快捷联系' : 'Contact shortcuts'} data-floating-contact
  class="fixed right-[max(.5rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 grid justify-items-center gap-2 sm:right-5 sm:gap-4">
  {whatsappHref && <a href={whatsappHref} target="_blank" rel="noopener" data-whatsapp-inquiry class={button}>
    <span class:list={[circle, 'pulse-whatsapp']} aria-hidden="true"></span>
    <span class={label}>{copy.floatingSupport}</span>
  </a>}
  <a href={localizedHref('/contact#contact-inquiry', locale)} data-floating-inquiry class={button}>
    <span class:list={[circle, 'pulse-email bg-[#245da8] group-hover:bg-[#184781]']}>
      <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
      </svg>
    </span>
    <span class={label}>{copy.floatingEmail}</span>
  </a>
</nav>

<style>
  .contact-icon {
    position: relative;
    isolation: isolate;
  }
  .pulse-whatsapp {
    --pulse-color: var(--whatsapp-rgb);
    --pulse-delay: 0s;
    background: var(--whatsapp-green);
    color: var(--whatsapp-ink);
  }
  .group:hover .pulse-whatsapp { background: var(--whatsapp-hover); }
  .pulse-email {
    --pulse-color: 84 164 254;
    --pulse-delay: .55s;
  }
  .contact-icon::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border: 2px solid rgb(var(--pulse-color) / .85);
    border-radius: inherit;
    box-shadow: 0 0 12px rgb(var(--pulse-color) / .55);
    opacity: 0;
    content: "";
    pointer-events: none;
    animation: contact-ripple 2.6s ease-out var(--pulse-delay) infinite both;
  }
  @keyframes contact-ripple {
    0% { transform: scale(1); opacity: .85; }
    70%, 100% { transform: scale(1.48); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-icon::before { animation: none; }
  }
</style>
