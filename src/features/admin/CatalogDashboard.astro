---
import { env } from 'cloudflare:workers';
import { trafficOverview } from '../analytics/report';
import { publicOrigin } from '../http/origin';

import { getConfig } from '../../config';
import { normalizeTimeZone } from '../settings/timeZone';

const timeZone = normalizeTimeZone(Astro.locals.settings?.timeZone ?? getConfig().timeZone) ?? 'UTC';
const reportParams = new URLSearchParams({ days: '1' });
const [products, pending, traffic] = await Promise.all([
  env.DB.prepare('SELECT COUNT(*) AS total, COUNT(CASE WHEN active = 1 THEN 1 END) AS published FROM products')
    .first<{ total: number; published: number }>(),
  env.DB.prepare('SELECT public_id, name FROM products WHERE active = 0 ORDER BY created_at DESC, id DESC LIMIT 6')
    .all<{ public_id: string; name: string }>(),
  trafficOverview(env.DB, reportParams, timeZone).catch(error => {
    console.error('Admin dashboard traffic unavailable', error);
    return null;
  }),
]);
const total = products?.total ?? 0;
const published = products?.published ?? 0;
const fmt = new Intl.NumberFormat('zh-CN');
const hour = new Intl.DateTimeFormat('zh-CN', { timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
const updatedAt = new Intl.DateTimeFormat('zh-CN', {
  timeZone, month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
}).format(Date.now());
const bars = traffic?.series ?? [];
const maxViews = Math.max(1, ...bars.map(point => point.views));
const metrics = [
  { label: '已上架', value: published, href: '/admin/products?status=active' },
  { label: '待上架', value: total - published, href: '/admin/products?status=inactive' },
  { label: '独立访客', value: traffic?.current.visitors, href: '/admin/traffic?days=1&metric=visitors' },
  { label: '页面浏览', value: traffic?.current.views, href: '/admin/traffic?days=1&metric=views' },
  { label: 'WhatsApp 点击', value: traffic?.current.clicks, href: '/admin/traffic?days=1&metric=clicks' },
];
const tasks = [
  { title: '批量导入', href: '/admin/imports', text: '检查采集助手连接与导入状态。' },
  { title: '编辑网站内容', href: '/admin/site-content', text: '更新首页、联系页与公共文案。' },
  { title: '管理素材', href: '/admin/media', text: '上传、查找图片和检查引用。' },
  { title: 'WhatsApp 管理', href: '/admin/whatsapp', text: '设置全站询价号码。' },
];
const hasNumber = Boolean(Astro.locals.settings?.whatsappNumber);
const origin = publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN);
---
<section class="admin-dashboard space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-[2.15rem]">工作台</h1>
    </div>
    <a href="/admin/products/new"
      class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-4">
      <span aria-hidden="true" class="text-lg leading-none">+</span> 新增商品
    </a>
  </header>

  <section aria-labelledby="summary-title">
    <h2 id="summary-title" class="sr-only">商品与访问概览</h2>
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5">
      {metrics.map((item, index) => (
        <div class:list={['admin-metric relative min-w-0 rounded-2xl border border-line bg-surface p-4 sm:p-5', index === 0 && 'admin-metric-featured']}>
          <dt class="pr-4 text-sm font-semibold">{item.label}</dt>
          <dd class="mt-3 break-words text-[1.85rem] leading-none font-bold tabular-nums">
            <a href={item.href} aria-label={'查看' + item.label} class="hover:underline">
              <span data-dashboard-value={index}>{item.value === undefined ? '—' : fmt.format(item.value)}</span>
              <span aria-hidden="true" class="absolute top-3 right-3 text-base font-normal">↗</span>
            </a>
          </dd>
          <dd class="mt-3 text-xs opacity-85">{index > 1 ? '今日' : '当前目录'}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="grid gap-4 xl:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <section class="admin-panel rounded-2xl border border-line bg-surface p-5 sm:p-6" aria-labelledby="dashboard-traffic-title">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <div>
          <h2 id="dashboard-traffic-title" class="text-lg font-bold">今日页面浏览</h2>
          <p class="mt-1 text-xs text-muted">站点时区 {timeZone} · 统计同意分析的访客</p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-sm font-semibold text-brand">
          <button type="button" hidden data-dashboard-refresh class="rounded-lg border border-line px-3 py-1 hover:bg-paper disabled:opacity-60">刷新数据</button>
          <a class="hover:underline" href="/admin/traffic?days=1&amp;metric=views">查看流量分析 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div data-dashboard-chart class="mt-4 min-w-0">
      {traffic ? (
        <ol class="admin-trend flex gap-2 overflow-x-auto pb-2 sm:gap-3" aria-label="按小时浏览次数" tabindex="0">
          {bars.map(point => (
            <li class="grid min-w-10 flex-1 grid-rows-[auto_1fr_auto] justify-items-center gap-2 text-xs tabular-nums">
              <span class="max-w-full truncate text-ink" title={fmt.format(point.views)}>{fmt.format(point.views)}</span>
              <div class="admin-bar-track" aria-hidden="true">
                <div class="admin-bar" style={`--bar-height:${100 * point.views / maxViews}%`}></div>
              </div>
              <span class="whitespace-nowrap text-muted">{hour.format(point.bucket * 1000)}</span>
            </li>
          ))}
        </ol>
      ) : <p class="rounded-xl bg-paper p-4 text-sm text-muted">暂时无法读取流量统计。</p>}
      </div>
      <p class="mt-2 text-xs text-muted" data-dashboard-updated={traffic ? 'ok' : 'error'}>
        {traffic ? '更新于 ' + updatedAt : '等待更新'}
      </p>
      <span class="sr-only" role="status" data-dashboard-announcement></span>
    </section>

    <section class="admin-panel rounded-2xl border border-line bg-surface p-5 sm:p-6" aria-labelledby="recent-drafts">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="recent-drafts" class="text-lg font-bold">最近待上架</h2>
        <a href="/admin/products?status=inactive" class="text-sm font-semibold text-brand hover:underline">查看全部</a>
      </div>
      {pending.results.length ? (
        <ul class="mt-3 divide-y divide-line">
          {pending.results.map(product => (
            <li class="flex items-center justify-between gap-3 py-3 text-sm">
              <a class="break-words font-medium hover:text-brand" href={'/admin/products/' + product.public_id + '/edit'}>{product.name}</a>
              <span class="shrink-0 rounded-full bg-paper px-2 py-0.5 text-xs text-muted">待上架</span>
            </li>
          ))}
        </ul>
      ) : <p class="mt-4 rounded-xl border border-dashed border-line bg-paper/70 px-4 py-5 text-sm text-muted">暂无待上架商品。</p>}
    </section>

  </div>

  <section class="admin-panel rounded-2xl border border-line bg-surface p-5 sm:p-6" aria-labelledby="quick-actions">
    <h2 id="quick-actions" class="text-lg font-bold">常用操作</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {tasks.map(task => <a href={task.href} class="group rounded-xl border border-line bg-paper/55 p-4 hover:border-brand hover:bg-[#edf8f5]">
        <h3 class="flex items-center justify-between gap-2 text-sm font-semibold">{task.title}<span aria-hidden="true" class="text-brand opacity-70 group-hover:opacity-100">→</span></h3>
        <p class="mt-1 text-xs leading-relaxed text-muted">{task.text}</p>
      </a>)}
    </div>
  </section>

  <section class="admin-panel flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-line bg-surface p-5 sm:p-6" aria-label="站点与联系入口">
    <div>
      <h2 class="text-base font-bold">网站与询价入口</h2>
      <a class="mt-1 block break-all text-sm text-brand underline" href={origin} target="_blank" rel="noopener">{origin}</a>
    </div>
    <a class:list={['rounded-full px-3 py-1.5 text-sm font-semibold hover:underline', hasNumber ? 'bg-[#e6f5ee] text-[#0c5c50]' : 'bg-amber-50 text-amber-900']}
      href="/admin/whatsapp">WhatsApp {hasNumber ? '已设置' : '待设置'}</a>
  </section>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-dashboard-refresh]');
  const chart = document.querySelector<HTMLElement>('[data-dashboard-chart]');
  const updated = document.querySelector<HTMLElement>('[data-dashboard-updated]');
  const announcement = document.querySelector<HTMLElement>('[data-dashboard-announcement]');
  if (button && chart && updated && announcement) {
    const refreshButton = button;
    const chartPanel = chart;
    const status = updated;
    const liveMessage = announcement;
    const values = Array.from(document.querySelectorAll<HTMLElement>('[data-dashboard-value]'));
    const chartList = () => chartPanel.querySelector<HTMLElement>('.admin-trend');
    const initialList = chartList();
    if (initialList) initialList.scrollLeft = initialList.scrollWidth;
    refreshButton.hidden = false;

    async function refresh(manual = false) {
      if (refreshButton.disabled || document.hidden) return;
      refreshButton.disabled = true;
      try {
        const response = await fetch(location.pathname, { cache: 'no-store', signal: AbortSignal.timeout(12000) });
        if (!response.ok || response.redirected) throw new Error('Dashboard unavailable');
        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
        const freshChart = page.querySelector('[data-dashboard-chart]');
        const freshStatus = page.querySelector('[data-dashboard-updated="ok"]');
        const freshValues = page.querySelectorAll('[data-dashboard-value]');
        if (!freshChart || !freshStatus || freshValues.length !== values.length) throw new Error('Dashboard unavailable');
        values.forEach((value, index) => { value.textContent = freshValues[index].textContent; });
        const oldList = chartList();
        const scrollLeft = oldList?.scrollLeft ?? 0;
        const atLatest = !oldList || oldList.scrollWidth - oldList.clientWidth - scrollLeft < 8;
        const chartFocused = document.activeElement === oldList;
        chartPanel.replaceChildren(...Array.from(freshChart.childNodes));
        const list = chartList();
        if (list) {
          list.scrollLeft = atLatest ? list.scrollWidth : scrollLeft;
          if (chartFocused) list.focus({ preventScroll: true });
        }
        status.textContent = freshStatus.textContent;
        if (manual) liveMessage.textContent = '今日数据已刷新。';
      } catch {
        const previous = status.textContent?.trim().split(' · ')[0] ?? '';
        status.textContent = previous + ' · 暂未更新，可重试';
        if (manual) liveMessage.textContent = '暂时无法刷新今日数据。';
      } finally {
        refreshButton.disabled = false;
      }
    }

    refreshButton.addEventListener('click', () => { void refresh(true); });
    window.setInterval(() => { void refresh(); }, 30000);
    document.addEventListener('visibilitychange', () => { void refresh(); });
  }
</script>
