---
import { isTrafficPath } from './events';
import { display, originalStorefrontPath, type StoreLocale } from '../i18n/locale';
import { storedAdPixels } from './pixelSettings';

interface Props {
  path: string;
  locale?: StoreLocale;
  pixelSettings?: string;
}
const { path: rawPath, pixelSettings, locale } = Astro.props;
const path = originalStorefrontPath(rawPath);
const t = (english: string, chinese: string) => display(locale, english, chinese);
---
{isTrafficPath(path) && (
  <div data-traffic-controls data-path={path} data-pixels={JSON.stringify(storedAdPixels(pixelSettings))}>
    <div class="mx-auto max-w-6xl px-6 pb-6 text-sm text-muted">
      <button type="button" data-consent-open hidden class="underline hover:text-brand">{t('Privacy preferences', '隐私偏好')}</button>
    </div>
    <section data-consent-panel hidden aria-labelledby="site-privacy-title"
      class="fixed inset-x-3 bottom-3 z-50 max-w-lg rounded-xl border border-line bg-surface p-4 text-sm shadow-lg sm:left-5 sm:right-auto">
      <h2 id="site-privacy-title" class="font-semibold">{t('Privacy preferences', '隐私偏好')}</h2>
      <p class="mt-1 text-muted">{t('Choose whether we can measure site use and advertising performance.', '请选择是否允许统计访问和广告效果。')}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-consent="reject" class="rounded border border-line px-3 py-2">{t('Reject optional', '拒绝非必要项')}</button>
        <button type="button" data-consent="analytics" class="rounded border border-line px-3 py-2">{t('Analytics only', '仅允许访问统计')}</button>
        <button type="button" data-consent="all" class="rounded bg-brand px-3 py-2 text-on-brand">{t('Allow analytics and ads', '允许统计与广告')}</button>
      </div>
    </section>
  </div>
)}
<script>
  import './tracking.browser';
</script>
