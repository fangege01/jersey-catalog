---
import type { Product } from './db';
import type { CategoryOption } from '../categories/db';
import { getConfig, toMajorUnits, currencyDecimals } from '../../config';
import { formatWeightValue, type WeightUnit } from '../shipping/weight';
import { attachmentActive, productAttachmentsEnabled } from '../digitalDelivery/rollout.ts';
import { readWholesalePrices, wholesaleFields, wholesaleRanges } from './wholesale';
import { DETAIL_SECTION_LIMIT, detailSectionFields, detailSectionKeys, readProductDetailSections } from './detailSections';
import { MIN_RELEASE_YEAR, MAX_RELEASE_YEAR, releaseYearFromTitle } from './releaseYear';
import { defaultProductMeta, importedProductSeo } from './seo';
import ImageSeoFields from './ImageSeoFields.astro';
import ProductRichEditor from './ProductRichEditor.astro';

interface Props {
  action: string;
  submitLabel: string;
  product?: Product | null;
  error?: string | null;
  /** Depth-tagged categories to choose from (empty = no categories yet). */
  categoryOptions?: CategoryOption[];
  /** Ids of categories this product currently belongs to. */
  selectedCategoryIds?: number[];
  /** Show the single-image upload (true on create; edit uses the gallery). */
  showImage?: boolean;
  /** Optional form id, so out-of-tree inputs (e.g. the variants editor) can submit
      with this form via the HTML `form="..."` attribute. */
  formId?: string;
  /** Store-wide weight unit (Admin → Settings). Storage is always grams. */
  weightUnit?: WeightUnit;
  /** True when every enabled zone prices by weight, so a blank weight would make
   *  this product unsellable. Shown as a requirement rather than discovered later. */
  weightRequired?: boolean;
}

const {
  action,
  submitLabel,
  product = null,
  error = null,
  categoryOptions = [],
  selectedCategoryIds = [],
  showImage = true,
  formId,
  weightUnit = 'g',
  weightRequired = false,
} = Astro.props;
const selected = new Set(selectedCategoryIds);
const catalogOnly = getConfig().features.catalogOnly;
// New products default to the store currency; edits keep their own.
const defaultCurrency = product?.currency ?? getConfig().currency;
const priceDecimals = currencyDecimals(defaultCurrency);
const price = product && (!catalogOnly || product.price_cents > 0)
  ? toMajorUnits(product.price_cents, product.currency).toFixed(currencyDecimals(product.currency))
  : '';
const wholesale = readWholesalePrices(product?.wholesale_prices);
const detailSections = readProductDetailSections(product?.detail_sections).source;
const importedSeo = product ? importedProductSeo(product) : null;
const defaultDescription = defaultProductMeta(
  [importedSeo?.intro, importedSeo?.description].filter(Boolean).join('\n\n') || product?.description || null,
);
// Input increment matches the currency's precision: 0.01 (USD), 1 (JPY), 0.001 (BHD).
const priceStep = priceDecimals > 0 ? (10 ** -priceDecimals).toFixed(priceDecimals) : '1';
const inputClass =
  'mt-1 w-full rounded-md border border-line px-3 py-2 focus:border-brand focus:outline-none';
---

<form
  method="POST"
  action={action}
  enctype="multipart/form-data"
  id={formId}
  class="max-w-lg space-y-4"
>
  {
    error && (
      <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        {error}
      </p>
    )
  }

  <div>
    <label class="block text-sm font-medium" for="name">{product ? '标题' : '名称'}</label>
    <input id="name" name="name" type="text" required value={product?.name ?? ''} class={inputClass} />
  </div>

  <div>
    <ProductRichEditor field="description" label="商品描述" value={product?.description ?? ''} rows={catalogOnly ? 6 : 3} />
    <p class="mt-1 text-xs text-gray-500">
      {catalogOnly
        ? '可填写中文或英文商品资料。中文自动翻译，英文保留原文。'
        : <>支持纯文本和 Markdown，包括段落、列表、链接及 <code>/images/…</code> 图片。</>}
    </p>
  </div>

  {catalogOnly ? (
    <fieldset class="rounded-md border border-line p-4">
      <legend class="px-1 text-sm font-semibold">阶梯报价（{defaultCurrency.toUpperCase()} / 件）</legend>
      <p class="mb-3 text-xs text-muted">未定价的档位留空，前台显示「询价」。</p>
      <div class="grid grid-cols-2 gap-3">
        <label class="block text-sm" for="price">{wholesaleRanges[0]} 件
          <input id="price" name="price" type="number" inputmode="decimal" step={priceStep} min="0" value={price} class={inputClass} />
        </label>
        {wholesaleFields.map((field, index) => (
          <label class="block text-sm" for={field}>{wholesaleRanges[index + 1]} 件
            <input id={field} name={field} type="number" inputmode="decimal" step={priceStep} min={priceStep}
              value={wholesale[index] === null ? '' : toMajorUnits(wholesale[index]!, defaultCurrency).toFixed(priceDecimals)} class={inputClass} />
          </label>
        ))}
      </div>
    </fieldset>
  ) : (
    <div>
      <label class="block text-sm font-medium" for="price">价格（{defaultCurrency.toUpperCase()}）</label>
      <input id="price" name="price" type="number" step={priceStep} min="0" required value={price} class={inputClass} />
    </div>
  )}
  {catalogOnly && (
    <fieldset class="space-y-3 rounded-md border border-line p-4">
      <legend class="px-1 text-sm font-semibold">商品详情模块</legend>
      <p class="text-xs text-muted">可填中文或英文。留空的模块会在前台隐藏。</p>
      {detailSectionKeys.map((key) => (
        <ProductRichEditor field={key} label={detailSectionFields[key]} value={detailSections[key]} rows={3}
          checklist={key !== 'quoteNote'} limit={DETAIL_SECTION_LIMIT} />
      ))}
    </fieldset>
  )}
  {catalogOnly ? (
    <div>
      <label class="block text-sm font-medium" for="release_year">商品年份</label>
      <input id="release_year" name="release_year" type="number" min={MIN_RELEASE_YEAR} max={MAX_RELEASE_YEAR}
        step="1" value={product?.release_year ?? undefined}
        placeholder={String(releaseYearFromTitle(product?.name ?? '') ?? '例如 2026')} class={inputClass}
        aria-describedby="release-year-help" />
      <p id="release-year-help" class="mt-1 text-xs text-muted">留空时从商品标题识别年份。已上架商品自动显示有货。</p>
    </div>
  ) : (
    <div>
      <label class="block text-sm font-medium" for="stock">库存</label>
      <input id="stock" name="stock" type="number" step="1" min="0" value={product?.stock ?? 0} class={inputClass} />
    </div>
  )}

  <details class="rounded-md border border-line p-4">
    <summary class="cursor-pointer text-sm font-semibold">SEO 搜索引擎优化设置</summary>
    <div class="mt-4 space-y-4">
      <div>
        <label class="block text-sm font-medium" for="seo_title">SEO Title（搜索引擎标题）</label>
        <input id="seo_title" name="seo_title" type="text" value={product?.seo_title ?? ''}
          placeholder={importedSeo?.title || product?.name || '留空时使用商品名称'} class={inputClass} aria-describedby="seo-title-help" />
        <p id="seo-title-help" class="mt-1 text-xs text-muted">建议 50–60 个英文字符。商品详情页的可见标题独立显示。</p>
      </div>
      <div>
        <label class="block text-sm font-medium" for="meta_description">Meta Description（搜索引擎描述）</label>
        <textarea id="meta_description" name="meta_description" rows="3" class={inputClass} aria-describedby="meta-description-help"
          placeholder={importedSeo?.metaDescription || defaultDescription || '留空时从商品描述生成'}>{product?.meta_description ?? ''}</textarea>
        <p id="meta-description-help" class="mt-1 text-xs text-muted">建议 140–160 个英文字符，简洁描述真实商品。手填内容会完整保存。</p>
      </div>
      <div>
        <label class="block text-sm font-medium" for="slug">URL Slug（商品专属网址）</label>
        <input id="slug" name="slug" type="text" value={product?.slug ?? ''} placeholder="根据英文商品名称自动生成"
          class={inputClass} aria-describedby="slug-help" />
        <p id="slug-help" class="mt-1 text-xs text-muted">输入英文字母、数字和连字符。编辑时留空沿用当前网址。已发布商品改址后，旧链接会自动跳转。</p>
      </div>
    </div>
  </details>

  {!catalogOnly && attachmentActive() && <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">配送</legend>
    <label class="flex items-center gap-2 text-sm">
      <input
        name="requires_shipping"
        type="checkbox"
        checked={product ? product.requires_shipping === 1 : true}
        class="h-4 w-4"
      />
      需要配送
    </label>
    <p class="mt-1 text-xs text-muted">
      电子书、礼品卡等数字商品请取消勾选。数字商品无需填写重量。
    </p>
    <div class="mt-3">
      <label class="block text-sm font-medium" for="weight">重量（{weightUnit})</label>
      <input
        id="weight"
        name="weight"
        type="text"
        inputmode="decimal"
        value={product?.weight_grams != null ? formatWeightValue(product.weight_grams, weightUnit) : ''}
        class={inputClass}
      />
      <p class="mt-1 text-xs text-muted">
        填写商品的包装后重量。配送设置中的订单包装重量会另计。
        {weightRequired
          ? ' Required: every shipping zone prices by weight, so this product cannot be sold without it.'
          : ' Optional while a flat rate is available.'}
      </p>
    </div>
  </fieldset>}

  {productAttachmentsEnabled(catalogOnly) && <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">数字交付</legend>
    {product?.file_key && (
      <p class="mb-3 text-sm text-muted">
        附件： <strong>{product.file_name ?? 'download'}</strong>
        {product.file_size_bytes != null && ` (${Math.ceil(product.file_size_bytes / 1024)} KB)`}
      </p>
    )}
    <label class="block text-sm font-medium" for="deliverable">{product?.file_key ? 'Replace file' : 'Attach file'}</label>
    <input
      id="deliverable"
      name="deliverable"
      type="file"
      accept=".pdf,.zip,.epub,.mp3,.m4a,.txt"
      class="mt-1 block w-full text-sm text-muted"
    />
    <p class="mt-1 text-xs text-muted">付款后可通过私有链接下载。支持 PDF、ZIP、EPUB、MP3、M4A 和 TXT，最大 25 MB。仅供下载的商品请取消勾选 <strong>需要配送</strong> 。</p>
    {product?.file_key && (
      <label class="mt-3 flex items-center gap-2 text-sm">
        <input type="checkbox" name="remove_deliverable" class="h-4 w-4" />
        此后的订单不再提供该附件
      </label>
    )}
  </fieldset>}

  {
    showImage && (
      <div>
        <label class="block text-sm font-medium" for="image">
          图片
        </label>
        <input id="image" name="image" type="file" accept="image/*" class="mt-1 block w-full text-sm text-muted file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-medium file:uppercase file:tracking-wider file:text-on-brand hover:file:bg-brand-hover" />
        <details class="mt-3 rounded-md border border-line p-3">
          <summary class="cursor-pointer text-sm font-semibold">主图 SEO 设置</summary>
          <div class="mt-3"><ImageSeoFields productName={product?.name} /></div>
        </details>
      </div>
    )
  }

  {
    categoryOptions.length > 0 && (
      <fieldset>
        <legend class="block text-sm font-medium">分类管理</legend>
        <div class="mt-1 max-h-48 space-y-1 overflow-auto rounded-md border border-line p-2">
          {categoryOptions.map((c) => (
            <label
              class="flex items-center gap-2 text-sm"
              style={`padding-left:${c.depth * 16}px`}
            >
              {/* cat_ public IDs — resolved back to row ids server-side. */}
              <input
                type="checkbox"
                name="category"
                value={c.public_id}
                checked={selected.has(c.id)}
                class="h-4 w-4"
              />
              {c.name}
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <label class="flex items-center gap-2 text-sm">
    <input name="active" type="checkbox" checked={product ? product.active === 1 : true} class="h-4 w-4" />
    上架（在前台显示）
  </label>

  <input type="hidden" name="currency" value={defaultCurrency} />

  <div class="flex gap-3 pt-2">
    <button type="submit" class="rounded-md bg-brand px-5 py-2 font-medium text-on-brand hover:bg-brand-hover">
      {submitLabel}
    </button>
    <a href="/admin/products" class="rounded-md border border-line px-5 py-2 hover:bg-surface">取消</a>
  </div>
</form>
