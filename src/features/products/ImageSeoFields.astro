---
import type { ProductImageRow } from './db';
import { storedSeoFilename } from '../media/seoName';

interface Props {
  image?: ProductImageRow;
  productName?: string;
}

const { image, productName } = Astro.props;
const input = 'mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 focus:border-brand focus:outline-none';
const generated = image && storedSeoFilename(image.image_key);
---
<div class="grid min-w-0 gap-3">
  <label class="block text-sm">Image Filename（图片文件名）
    <input name="image_filename" type="text" value={image?.seo_alias?.split('/').at(-1) ?? ''}
      placeholder={generated || '留空使用根据商品名称生成的文件名'} class={input} draggable="false" />
    <span class="mt-1 block text-xs text-muted">可填英文名称，如 argentina-jersey-back。扩展名随原图格式保留。</span>
  </label>
  <label class="block text-sm">Image ALT Text（图片替代文字）
    <input name="alt" type="text" value={image?.alt ?? ''} placeholder={productName || '留空使用商品名称'} class={input} draggable="false" />
    <span class="mt-1 block text-xs text-muted">建议写这张照片实际展示的角度或细节。留空时商品页面会使用商品名称。</span>
  </label>
  <label class="block text-sm">Image Title（图片标题）
    <input name="image_title" type="text" value={image?.title ?? ''} class={input} draggable="false" />
  </label>
  <label class="block text-sm">Image Caption（图片说明）
    <textarea name="image_caption" rows="2" class={input} draggable="false">{image?.caption ?? ''}</textarea>
  </label>
</div>
