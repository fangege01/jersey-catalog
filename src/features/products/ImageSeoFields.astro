---
import type { ProductImageRow } from './db';
import { storedSeoFilename } from '../media/seoName';

interface Props {
  image?: ProductImageRow;
  productName?: string;
}

const { image, productName } = Astro.props;
const input = 'seo-image-text mt-1 block w-full min-w-0 rounded-md border border-line bg-paper px-2.5 py-2 text-sm focus:border-brand focus:outline-none';
const generated = image && storedSeoFilename(image.image_key);
---
<div class="grid min-w-0 gap-3">
  <label class="block min-w-0 text-sm">图片文件名
    <textarea name="image_filename" rows="3" wrap="soft" spellcheck="false"
      placeholder={generated || '留空使用根据商品名称生成的文件名'} class={input} draggable="false">{image?.seo_alias?.split('/').at(-1) ?? ''}</textarea>
    <span class="mt-1 block text-xs text-muted">可填英文名称，如 argentina-jersey-back。扩展名随原图格式保留。</span>
  </label>
  <label class="block min-w-0 text-sm">图片 ALT（替代文字）
    <textarea name="alt" rows="4" wrap="soft"
      placeholder={productName || '留空使用商品名称'} class={input} draggable="false">{image?.alt ?? ''}</textarea>
    <span class="mt-1 block text-xs text-muted">建议写这张照片实际展示的角度或细节。留空时商品页面会使用商品名称。</span>
  </label>
</div>

<style>
  .seo-image-text {
    field-sizing: content;
    min-block-size: 4rem;
    overflow-wrap: anywhere;
    resize: vertical;
  }
</style>
