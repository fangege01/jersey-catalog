---
import type { ProductDetailModel, ProductPurchaseModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import ProductGallery from '../../features/storefront/controls/ProductGallery.astro';
import ProductPurchaseForm from '../../features/storefront/controls/ProductPurchaseForm.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * Composition only. Every price, URL, availability flag, and image on `model`
 * is already resolved; the route owns the 404, the metadata, and the JSON-LD.
 *
 * Keep <ProductGallery> and <ProductPurchaseForm>. The gallery owns the anchors
 * the variant selector scrolls to and the LCP treatment on the first frame; the
 * purchase form owns the field names, the sold-out states, and `data-fullpage`,
 * without which Buy now is captured by the cart drawer instead of navigating.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: ProductDetailModel;
  purchase: ProductPurchaseModel;
}

const { model, purchase } = Astro.props;
const zh = model.locale === 'zh-CN';
---

<a href={model.backHref} class="text-xs uppercase tracking-widest text-faint hover:text-brand">
  &larr; {zh ? '返回商城' : 'Back to shop'}
</a>

{
  model.error && (
    <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
      {model.error}
    </p>
  )
}


<div class="mt-6 grid gap-10 md:grid-cols-2 md:gap-16">
  <ProductGallery
    images={model.images}
    hero={model.heroImage}
    soldOut={model.soldOut}
    soldOutLabel={zh ? '暂时缺货' : undefined}
    class="reveal"
  />

  <div class="reveal flex flex-col" style="animation-delay:90ms">
    {
      !model.catalogBadges && model.categories.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-x-4 gap-y-1 text-xs uppercase tracking-widest text-faint">
          {model.categories.map((category) => (
            <a href={category.href} class="hover:text-brand">
              {category.text}
            </a>
          ))}
        </div>
      )
    }

    <h1 class="font-serif text-4xl tracking-tight">{model.name}</h1>
    {model.catalogBadges && (
      <ul class="mt-3 flex flex-wrap gap-2 text-xs font-semibold" aria-label={zh ? '商品标签' : 'Product labels'} data-product-badges>
        {model.catalogBadges.category && (
          <li>
            <a href={model.catalogBadges.category.href} class="inline-block rounded-md bg-brand/10 px-2.5 py-1 text-brand hover:underline">
              {model.catalogBadges.category.text}
            </a>
          </li>
        )}
        {model.catalogBadges.year !== null && (
          <li class="rounded-md bg-sky-100 px-2.5 py-1 tabular-nums text-sky-900">{model.catalogBadges.year}</li>
        )}
        <li class="rounded-md bg-emerald-100 px-2.5 py-1 text-emerald-900">{zh ? '有货' : 'In stock'}</li>
      </ul>
    )}
    {model.digitalDelivery && <p class="mt-2 text-xs uppercase tracking-widest text-brand">{zh ? '数字下载' : 'Digital download'}</p>}
    {model.wholesale ? (
      <div class="mt-5 overflow-hidden rounded-xl border border-line">
        <table class="w-full border-collapse text-sm">
          <caption class="sr-only">{zh ? '阶梯报价' : 'Volume pricing'}</caption>
          <thead class="bg-brand text-on-brand">
            <tr>
              <th scope="col" class="px-4 py-3 text-left font-semibold">{zh ? '订购数量' : 'Order quantity'}</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">
                {zh ? '每件参考价' : 'Unit price'} ({model.wholesale.currency})
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line bg-surface">
            {model.wholesale.tiers.map((tier) => (
              <tr class="even:bg-paper">
                <th scope="row" class="px-4 py-3.5 text-left font-medium">{tier.range} {zh ? '件' : 'pcs'}</th>
                <td class:list={['px-4 py-3.5 text-right tabular-nums', tier.price ? 'font-bold text-brand' : 'text-muted']}>
                  {tier.price ?? (zh ? '询价' : 'On request')}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p
      class="mt-4 text-2xl tabular-nums text-muted"
      data-price-display
      data-base={model.priceCents}
      data-currency={model.currency}
    >
      {model.priceVaries && <span class="text-base text-faint">{zh ? '起价 ' : 'From '}</span>}
      {model.formattedPrice}
    </p>}
    {model.quoteNote && (
      <p class="mt-4 whitespace-pre-line break-words rounded-lg border border-red-200 border-s-4 border-s-red-600 bg-red-100 px-4 py-3 text-sm leading-relaxed text-black">
        {model.quoteNote}
      </p>
    )}
    {
      /* data-low-stock is the contract, not the wording. Reword or restyle it
         freely; keep the marker so scarcity stays distinguishable from normal
         availability without pinning copy. */
      model.lowStock && (
        <p data-low-stock class="mt-2 text-sm text-amber-700">
          {zh ? '库存较少' : 'Low stock'}
        </p>
      )
    }
    {
      !purchase.inquiry && model.descriptionHtml && (
        <div class="markdown-content mt-6 max-w-prose text-muted" set:html={model.descriptionHtml} />
      )
    }

    {purchase.inquiry ? (
      <div class="mt-6 rounded-xl border border-line bg-surface px-5 pb-5 pt-4 sm:px-6">
        <h2 class="text-lg font-medium">{zh ? '申请报价' : 'Request a quote'}</h2>
        <p class="mt-1 text-sm text-muted">{zh ? '咨询数量、尺码和配送。' : 'Ask about quantities, available sizes, or delivery.'}</p>
        <ProductPurchaseForm model={purchase} />
      </div>
    ) : <ProductPurchaseForm model={purchase} />}

    {model.detailSections?.map((section) => (
      <section class="mt-5 border-t border-line pt-4">
        <h2 class="text-sm font-semibold text-ink">{section.title}</h2>
        <ul class="mt-2 space-y-2 text-sm text-muted">
          {section.items.map((item) => (
            <li class="flex items-start gap-2">
              <span class="text-brand" aria-hidden="true">✓</span>
              <span class="min-w-0 break-words">{item}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {/* Share — hidden until JS confirms the browser can share or copy. Uses the
        Web Share API (mobile/native sheet) with a clipboard-copy fallback. */}
    <button
      type="button"
      data-share
      data-share-title={model.name}
      class="mt-6 hidden w-fit items-center gap-2 text-xs uppercase tracking-widest text-faint transition hover:text-brand"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
        <line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
      </svg>
      <span data-share-label>{zh ? '分享' : 'Share'}</span>
    </button>
  </div>
</div>

{purchase.inquiry && model.descriptionHtml && (
  <section aria-labelledby="product-details" class="mt-12 border-t border-line pt-8 md:mt-16">
    <h2 id="product-details" class="font-serif text-2xl">{zh ? '商品详情' : 'Product details'}</h2>
    <div class="markdown-content mt-4 max-w-4xl overflow-x-auto text-muted" set:html={model.descriptionHtml} />
  </section>
)}

{
  model.related.length > 0 && (
    <section class="mt-20 border-t border-line pt-12">
      <h2 class="mb-8 text-xs uppercase tracking-[0.25em] text-faint">{zh ? '猜你喜欢' : 'You may also like'}</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4">
        {model.related.map((card, i) => (
          <ProductCard card={card} index={i} headingLevel="h3" />
        ))}
      </ul>
    </section>
  )
}
