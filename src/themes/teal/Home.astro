---
import type { CatalogPageModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
interface Props { model: CatalogPageModel; landing: NonNullable<CatalogPageModel['landing']>; }
const { model, landing } = Astro.props;
const { copy, image, metrics = [], whatsappHref: contact } = landing;
const zh = model.locale === 'zh-CN';
const t = (en: string, cn: string) => zh ? cn : en;
const slides = landing.slides?.length ? landing.slides : [image];
const shownMetrics = metrics.map(metric => {
  const decimals = metric.value.split('.')[1]?.length ?? 0;
  const displayValue = new Intl.NumberFormat(model.locale ?? 'en', {
    minimumFractionDigits: decimals, maximumFractionDigits: decimals,
  }).format(Number(metric.value));
  return { ...metric, displayValue };
});
const offers = [
  [copy.retailTitle, copy.retailText],
  [copy.teamTitle, copy.teamText],
  [copy.wholesaleTitle, copy.wholesaleText],
  [copy.customTitle, copy.customText],
];
const steps = [
  [copy.step1Title, copy.step1Text],
  [copy.step2Title, copy.step2Text],
  [copy.step3Title, copy.step3Text],
  [copy.step4Title, copy.step4Text],
];
---
<section class="hero" data-wide-catalog>
  <div class="frame hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heroTitle}{zh ? '' : ' '}<br /><em>{copy.heroAccent}</em></h1>
      <p>{copy.heroIntro}</p>
      <div class="buttons">
        <a class="button bright" href="/products">{copy.browseCta}</a>
        {contact && <a class="button outline" href={contact} data-whatsapp-inquiry>{copy.quoteCta}</a>}
      </div>
      <ul class="hero-options">
        {offers.map(([title]) => <li>{title}</li>)}
      </ul>
      {shownMetrics.length > 0 && <ul class="hero-stats" aria-label={t('Catalog at a glance', '网站数字指标')} role="list">
        {shownMetrics.map(({ value, displayValue, label, suffix }) => <li>
          <strong aria-hidden="true"><span data-hero-count={value}>{displayValue}</span>{suffix && <small>{suffix}</small>}</strong>
          <span class="sr-only">{displayValue}{suffix ? ' ' + suffix : ''}</span>
          <span class="hero-stat-label">{label}</span>
        </li>)}
      </ul>}
    </div>
    <div class="hero-visual" data-hero-slides={slides.length > 1 ? '' : undefined}>
      <div class="hero-slide-stack">
        {slides.map((slide, index) => <img class:list={[index === 0 && 'current']}
          src={slide.src} srcset={slide.srcset} sizes={slide.sizes} width="900" height="900"
          loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'}
          decoding="async" alt={slide.alt} aria-hidden={index > 0 ? 'true' : undefined} data-hero-slide />)}
      </div>
      {slides.length > 1 && <div class="hero-slide-controls" role="group"
        aria-label={t('Homepage image controls', '首页轮播控制')}
        data-pause={t('Pause slideshow', '暂停轮播')} data-play={t('Resume slideshow', '继续轮播')} hidden>
        {slides.map((_, index) => <button type="button" data-hero-dot
          data-label={t(`Show image ${index + 1}`, `显示第 ${index + 1} 张图片`)}
          aria-current={index === 0 ? 'true' : undefined}
          aria-label={t(`Show image ${index + 1}`, `显示第 ${index + 1} 张图片`)} />)}
      </div>}
    </div>
  </div>
</section>

<section class="section">
  <div class="frame">
    <div class="section-head">
      <h2>{copy.featuredTitle}</h2>
      <a href="/products">{copy.featuredLink} <span aria-hidden="true">→</span></a>
    </div>
    {model.products.length > 0 ? (
      <ul class="grid products">{model.products.map((card, i) => <ProductCard card={card} index={i} headingLevel="h3" locale={model.locale} />)}</ul>
    ) : <p class="text-muted" role="status">{copy.emptyFeatured}</p>}
  </div>
</section>

{model.categories.length > 0 && <section class="section pale">
  <div class="frame">
    <div class="section-head">
      <h2>{copy.categoryTitle}</h2>
      <a href="/products">{copy.categoryLink} <span aria-hidden="true">→</span></a>
    </div>
    <nav class="category-grid" aria-label={t('Jersey categories', '球衣分类')}>
      {model.categories.map(category => <a class="box" href={category.href}>{category.text} <span aria-hidden="true">→</span></a>)}
    </nav>
  </div>
</section>}

<section class="section" id="order-options">
  <div class="frame">
    <h2 class="center">{copy.optionsTitle}</h2>
    <div class="grid">
      {offers.map(([title, description], i) => (
        <article class="box">
          <div class="circle" aria-hidden="true">{['↗', '＋', '≡', '✦'][i]}</div>
          <h3>{title}</h3><p>{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section team-section">
  <div class="frame team-layout">
    <div class="team-card">
      <div>{copy.teamTag1}</div>
      <div>{copy.teamTag2}</div>
      <div>{copy.teamTag3}</div>
    </div>
    <div>
      <h2>{copy.teamCalloutTitle}</h2>
      <p>{copy.teamCalloutText}</p>
      <a class="team-link" href={contact || '/products'} data-whatsapp-inquiry={contact ? '' : undefined}>{contact ? copy.teamCalloutLink : t('Explore the catalog', '浏览球衣目录')} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="section pale supply-feature">
  <div class="frame">
    <div class="supply-feature-inner">
      <div>
        <h2>{copy.supplyTitle}</h2>
        <p>{copy.supplyText}</p>
      </div>
      <a class="button" href="/factory">{copy.supplyLink} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="section order-workflow" id="how-to-order" aria-labelledby="order-workflow-title">
  <div class="frame">
    <header class="order-heading">
      <p class="order-kicker">{copy.processKicker}</p>
      <h2 id="order-workflow-title">{copy.processTitle}</h2>
      <p class="order-intro">{copy.processIntro}</p>
    </header>
    <ol class="steps">
      {steps.map(([title, description], i) => (
        <li><b aria-hidden="true">{String(i + 1).padStart(2, '0')}</b><h3>{title}</h3><p>{description}</p></li>
      ))}
    </ol>
  </div>
</section>

<slot name="homepage-cases" />

<section class="section" id="faq" aria-labelledby="home-faq-title">
  <div class="frame">
    <h2 id="home-faq-title">{copy.faqTitle}</h2>
    <div class="questions">
      <details><summary>{copy.question1}</summary><p>{copy.answer1}</p></details>
      <details><summary>{copy.question2}</summary><p>{copy.answer2}</p></details>
      <details><summary>{copy.question3}</summary><p>{copy.answer3}</p></details>
    </div>
  </div>
</section>

<style>
.frame{width:min(100% - 3rem,75rem);margin-inline:auto;}
.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border-radius: 0 0 60px 60px;
  color: white;
  background: radial-gradient(ellipse at 84% 10%, rgba(14, 165, 233, .36), transparent 54%), linear-gradient(135deg, #0b2b2a 0%, #0f766e 58%, #0ea5e9 130%);
  border-block-end: 1px solid #ffffff45;
}
.hero::before {
  content: '';
  position: absolute;
  z-index: -1;
  inset: 0;
  background: repeating-linear-gradient(125deg, transparent 0 5rem, #a9e8fc0e 5rem calc(5rem + 1px));
  mask-image: linear-gradient(90deg, transparent 18%, #000 100%);
  pointer-events: none;
}
.hero-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.04fr) minmax(0, 1fr);
  gap: clamp(2rem, 5vw, 5rem);
  align-items: center;
  padding-block: clamp(3rem, 7vw, 6rem);
}
.hero-copy { min-width: 0; }
.eyebrow{font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#a9e8fc;font-size:.8rem;}
.hero h1{margin:1rem 0 1.2rem;font-size:clamp(2.6rem,5.15vw,4.75rem);line-height:1.03;font-weight:850;letter-spacing:-.055em;overflow-wrap:anywhere;}
.hero h1 em{color:#7dd3fc;font-style:normal;}
.hero-copy>p:not(.eyebrow){max-width:34rem;line-height:1.65;color:#e0f5f2;font-size:clamp(1rem,1.45vw,1.12rem);}
.buttons{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.55rem;}
.button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;border-radius:12px;padding:.65rem 1.1rem;font-weight:750;font-size:.95rem;}
.bright{background:#7dd3fc;color:#082e39;}.bright:hover{background:#bae6fd;}
.outline{border:1px solid rgba(255,255,255,.65);color:white;}.outline:hover{background:#ffffff15;}
.hero-options { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-top: 1.6rem; padding-top: 1rem; border-top: 1px solid #ffffff45; color: #e0f5f2; font-size: .82rem; }
.hero-options li { display: flex; align-items: baseline; gap: .45rem; }
.hero-options li::before { content: ''; flex: none; width: .32rem; height: .32rem; align-self: center; border-radius: 50%; background: #7dd3fc; }
.hero-options:has(+ .hero-stats) { border-top: 0; padding-top: 0; margin-top: 1.15rem; }
.hero-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem .95rem; margin: 1.45rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid #ffffff45; }
.hero-stats li { min-width: 0; overflow-wrap: anywhere; }
.hero-stats strong { display: block; color: white; font-size: clamp(1.45rem, 2.65vw, 2.125rem); font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.08; }
.hero-stats small { margin-inline-start: .18em; color: #a9e8fc; font-size: .45em; }
.hero-stat-label { display: block; margin-top: .35rem; color: #e0f5f2; font-size: .85rem; line-height: 1.4; }
.hero-visual {
  min-width: 0;
  overflow: hidden;
  padding: .5rem;
  border: 1px solid #a9e8fc80;
  border-radius: 1.75rem;
  background: linear-gradient(150deg, #5eead4ad, #0ea5e9ad);
  box-shadow: 0 24px 60px #020d135e;
}
.hero-visual img { display: block; width: 100%; height: auto; aspect-ratio: 1.06; object-fit: cover; border-radius: 1.25rem; background: #082e39; }
.hero-visual { position: relative; }
.hero-slide-stack { display: grid; }
.hero-slide-stack img { grid-area: 1 / 1; opacity: 0; transition: opacity 380ms ease; }
.hero-slide-stack img.current { opacity: 1; z-index: 1; }
.hero-slide-controls { position: absolute; z-index: 2; inset-inline-start: 50%; bottom: .95rem; transform: translateX(-50%); display: flex; align-items: center; padding: .1rem .25rem; border-radius: 999px; background: #082e39b3; }
.hero-slide-controls[hidden] { display: none; }
.hero-slide-controls button { display: grid; place-items: center; width: 1.65rem; height: 1.65rem; border-radius: 50%; }
.hero-slide-controls button::before { content: ''; width: .45rem; height: .45rem; border: 1px solid #ffffffde; border-radius: 50%; }
.hero-slide-controls button[aria-current='true']::before { background: #fff; border-color: #fff; }
.hero-slide-controls[data-paused] button[aria-current='true']::before { background: #7dd3fc; }
.hero-slide-controls button:hover { background: #ffffff25; }
.hero-slide-controls button:focus-visible { outline: 2px solid #7dd3fc; outline-offset: -2px; }
@media (prefers-reduced-motion: reduce) { .hero-slide-stack img { transition: none; } }
.supply-feature-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.35rem; padding: clamp(1.25rem, 4vw, 2.5rem); border: 1px solid #cde4e1; border-radius: 1.4rem; background: #fff; }
.supply-feature-inner p { max-width: 42rem; margin-top: .6rem; color: var(--color-muted); line-height: 1.65; }
.supply-feature-inner a { gap: .65rem; border: 1px solid #cde4e1; color: var(--color-brand); }
.supply-feature-inner a:hover { background: #edf7f4; }
.section{scroll-margin-top:84px;padding-block:clamp(2.5rem,5.3vw,5rem);}
.section h2{font-size:clamp(1.75rem,3.5vw,2.7rem);font-weight:800;line-height:1.18;}
.center{text-align:center;margin-bottom:1.7rem;}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.1rem;}
.box{min-width:0;border-radius:20px;padding:1.3rem;background:white;box-shadow:0 12px 30px rgba(13,148,136,.1);border:1px solid #e8f3f1;}
.box h3{margin:.6rem 0 .45rem;font-size:1.06rem;font-weight:750;}
.box p,.questions p{color:#4a5f63;font-size:.95rem;line-height:1.6;}
.pale{background:#f2f9f8;}
.section-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:1.3rem;}
.section-head a,.category-grid a{font-weight:750;color:#0f766e;}
.category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr));gap:.85rem;}
.category-grid a{display:flex;justify-content:space-between;gap:.65rem;}.category-grid a:hover{border-color:#5fb6ac;}
.team-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,5rem);align-items:center;}
.team-card{display:grid;gap:.75rem;padding:clamp(1.25rem,4vw,2.8rem);border-radius:28px;background:linear-gradient(140deg,#0f766e,#16869c);color:white;}
.team-card div{padding:.9rem 1rem;border:1px solid #ffffff56;border-radius:12px;background:#ffffff14;font-weight:700;}
.team-layout p{color:#4a5f63;margin:1rem 0;line-height:1.65;}
.team-link{color:#0f766e;font-weight:750;}
.team-link[data-whatsapp-inquiry]{display:inline-flex;align-items:center;flex-wrap:wrap;min-height:44px;padding:.55rem .9rem;border-radius:.75rem;}
.team-link:hover{text-decoration:underline;}
.order-workflow{background:#f2f6f8;color:#0e1b2c;}
.order-heading{max-width:46rem;margin-bottom:clamp(1.75rem,3vw,2.75rem);}
.order-kicker,.steps b{color:#047857;font-size:.875rem;font-weight:800;letter-spacing:.04em;}
.order-heading h2{margin:.75rem 0 1rem;}
.order-intro,.steps p{color:#526579;line-height:1.7;overflow-wrap:anywhere;}
.order-intro{font-size:1.05rem;}
.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(1rem,2vw,1.7rem);padding:0;list-style:none;}
.steps li{min-width:0;border-block-start:2px solid #10b981;padding-block-start:1.2rem;}
.steps b{font-variant-numeric:tabular-nums;}
.steps h3{margin:.65rem 0 .5rem;font-size:clamp(1.05rem,1.55vw,1.3rem);font-weight:750;line-height:1.4;overflow-wrap:anywhere;}
.questions{display:grid;gap:.55rem;margin-top:1.2rem;}
.questions details{border:1px solid #dcebe9;border-radius:12px;padding:.9rem 1rem;}
.questions summary{font-weight:650;}.questions p{padding-top:.5rem;}
@media(max-width:62rem){.grid,.steps{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:47rem){.frame{width:calc(100% - 2rem);}.hero{border-radius:0 0 32px 32px;}.hero-layout{grid-template-columns:1fr;gap:1.45rem;padding-block:2.35rem;}.hero-visual{width:min(100%,32rem);}.hero-visual img{aspect-ratio:1.24;}.hero-stats{grid-template-columns:repeat(2,minmax(0,1fr));}.steps,.team-layout{grid-template-columns:1fr;}}
@media(max-width:27rem){.grid{gap:.65rem;}.box{padding:.8rem;}.box p{font-size:.85rem;}}
</style>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-hero-slides]')) {
    const images = [...gallery.querySelectorAll<HTMLImageElement>('[data-hero-slide]')];
    const controls = gallery.querySelector<HTMLElement>('.hero-slide-controls');
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
    if (!controls || images.length < 2 || dots.length !== images.length) continue;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let running = !motion.matches;
    let timer: number;

    function updateDots() {
      controls!.toggleAttribute('data-paused', !running);
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
        dot.setAttribute('aria-label', (i === index
          ? running ? controls!.dataset.pause : controls!.dataset.play
          : dot.dataset.label) ?? '');
      });
    }

    function show(next: number) {
      images[index].classList.remove('current');
      images[index].setAttribute('aria-hidden', 'true');
      index = (next + images.length) % images.length;
      images[index].classList.add('current');
      images[index].removeAttribute('aria-hidden');
      updateDots();
    }

    function schedule() {
      window.clearTimeout(timer);
      if (!running || document.hidden || controls!.querySelector(':focus-visible')) return;
      timer = window.setTimeout(() => { show(index + 1); schedule(); }, 5000);
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => {
      if (i === index) {
        running = !running;
        updateDots();
      } else {
        show(i);
      }
      schedule();
    }));
    controls.addEventListener('focusin', schedule);
    controls.addEventListener('focusout', () => queueMicrotask(schedule));
    document.addEventListener('visibilitychange', schedule);
    motion.addEventListener('change', event => {
      if (event.matches) {
        running = false;
        updateDots();
        schedule();
      }
    });
    controls.hidden = false;
    updateDots();
    schedule();
  }

  // The server renders the final number for no-JS and reduced-motion visitors.
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) continue;
        observer.unobserve(entry.target);
        const element = entry.target;
        const raw = element.dataset.heroCount ?? '';
        const value = Number(raw);
        if (!value) continue;
        const precision = raw.split('.')[1]?.length ?? 0;
        const format = new Intl.NumberFormat(document.documentElement.lang || 'en', {
          minimumFractionDigits: precision, maximumFractionDigits: precision,
        });
        const started = performance.now();
        function step(now: number) {
          const progress = Math.min(Math.max((now - started) / 1400, 0), 1);
          element.textContent = format.format(value * (1 - (1 - progress) ** 3));
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
    }, { threshold: .4 });
    for (const element of document.querySelectorAll('[data-hero-count]')) observer.observe(element);
  }
</script>
