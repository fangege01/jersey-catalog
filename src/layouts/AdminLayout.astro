---
import { getConfig } from '../config';
import { paymentsInDemoMode } from '../features/payments';
import { shippingFor } from '../features/shipping/effective';
import { env } from 'cloudflare:workers';
import { countUnresolvedInventoryExceptions } from '../features/orders/db';
// Admin's OWN stylesheet — never global.css, which carries the active
// storefront set's tokens and base-layer rules. A dark set would otherwise
// restyle every authenticated Admin page (see src/styles/admin.css).
import '../styles/admin.css';

type Section =
  | 'dashboard'
  | 'products'
  | 'pending'
  | 'imports'
  | 'orders'
  | 'customers'
  | 'categories'
  | 'media'
  | 'pages'
  | 'navigation'
  | 'siteContent'
  | 'contactPage'
  | 'bottomInquiry'
  | 'orderWorkflow'
  | 'inquiries'
  | 'traffic'
  | 'adTracking'
  | 'contactPopup'
  | 'seo'
  | 'testimonials'
  | 'customerCases'
  | 'factoryShowcase'
  | 'factorySupply'
  | 'whatsapp'
  | 'shipping'
  | 'settings';

interface Props {
  title?: string;
  active?: Section;
}

const { title, active } = Astro.props;
const config = getConfig();
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
// Nudge to finish first-run setup — except while on the wizard itself.
const showSetupNudge =
  !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
// Show "Log out" only when a password-login session cookie is present. Under
// Cloudflare Access or local dev there's no minshop session to clear.
const showLogout = !!Astro.cookies.get('admin_session')?.value;
const pageTitle = title ? `${title} — ${storeName} 管理后台` : `${storeName} 管理后台`;
const catalogOnly = config.features.catalogOnly;
const shippingIssue = catalogOnly ? undefined : shippingFor(Astro.locals.settings).issue;
const inventoryExceptionCount = catalogOnly ? 0 : await countUnresolvedInventoryExceptions(env.DB);

type Item = { key: Section; label: string; href: string };
const groups: { label: string; links: Item[] }[] = [
  { label: '总览', links: [
    { key: 'dashboard', label: '工作台', href: '/admin' },
    { key: 'traffic', label: '流量分析', href: '/admin/traffic' },
  ] },
  { label: '商品与素材', links: [
    { key: 'products', label: '商品管理', href: '/admin/products' },
    ...(catalogOnly ? [{ key: 'imports' as const, label: '批量导入', href: '/admin/imports' }] : []),
    { key: 'pending', label: '待上架商品', href: '/admin/products?status=inactive' },
    { key: 'categories', label: '分类管理', href: '/admin/categories' },
    { key: 'media', label: '图片素材库', href: '/admin/media' },
  ] },
  ...(!catalogOnly ? [{ label: '交易与配送', links: [
    { key: 'orders' as const, label: '订单', href: '/admin/orders' },
    { key: 'customers' as const, label: '客户', href: '/admin/customers' },
    { key: 'shipping' as const, label: '配送', href: '/admin/shipping' },
  ] }] : []),
  { label: '网站内容', links: [
    { key: 'siteContent', label: '页面内容', href: '/admin/site-content' },
    ...(import.meta.env.MINSHOP_THEME === 'teal' ? [{ key: 'orderWorkflow' as const, label: '首页订购流程', href: '/admin/site-content?section=home&focus=process-copy' }] : []),
    { key: 'customerCases', label: '客户案例', href: '/admin/showcase?section=cases' },
    { key: 'testimonials', label: '客户好评', href: '/admin/testimonials' },
    { key: 'factorySupply', label: '供应与质量', href: '/admin/site-content?section=factory' },
    { key: 'factoryShowcase', label: '工厂展示', href: '/admin/showcase?section=factory' },
    { key: 'contactPage', label: '联系页面设置', href: '/admin/site-content?section=contact' },
    { key: 'pages', label: '自定义页面', href: '/admin/pages' },
    ...(catalogOnly ? [{ key: 'bottomInquiry' as const, label: '底部询盘设置', href: '/admin/site-content?section=home&focus=bottom-inquiry#bottom-inquiry' }] : []),
    { key: 'navigation', label: import.meta.env.MINSHOP_THEME === 'teal' ? '页脚导航' : '导航', href: '/admin/navigation' },
  ] },
  { label: '询价与营销', links: [
    { key: 'inquiries', label: '询盘管理', href: '/admin/inquiries' },
    ...(catalogOnly ? [{ key: 'whatsapp' as const, label: 'WhatsApp 管理', href: '/admin/whatsapp' }] : []),
    { key: 'contactPopup', label: '智能弹窗', href: '/admin/contact-popup' },
    { key: 'adTracking', label: '广告追踪', href: '/admin/ad-tracking' },
    { key: 'seo', label: 'SEO 与 AI 爬虫', href: '/admin/seo' },
  ] },
  { label: '系统设置', links: [
    { key: 'settings', label: '站点设置', href: '/admin/settings' },
  ] },
];
const navKey = active === 'products' && Astro.url.searchParams.get('status') === 'inactive' ? 'pending' : active;
const group = groups.find(group => group.links.some(link => link.key === navKey));
const currentLabel = title ?? group?.links.find(link => link.key === navKey)?.label ?? '管理后台';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <a class="admin-skip" href="#admin-content">跳转到主要内容</a>
    <div class="admin-frame">
      <aside class="admin-sidebar">
        <a href="/admin" class="admin-brand">
          <strong class="admin-mark">{storeName}</strong>
          <span class="admin-brand-label">管理后台</span>
        </a>
        <input type="checkbox" id="admin-nav" data-admin-nav-toggle class="peer sr-only" aria-label="切换后台菜单" />
        <label for="admin-nav" data-admin-nav-summary class="admin-nav-trigger">
          <span>菜单 <span class="admin-trigger-location">· {currentLabel}</span></span>
          <span aria-hidden="true" data-admin-nav-chevron>⌄</span>
        </label>
        <nav data-admin-nav-list class="admin-nav" aria-label="后台主菜单">
          {groups.map((section, index) => (
            <section aria-labelledby={'admin-group-' + index} class="admin-nav-group">
              <h2 id={'admin-group-' + index}>{section.label}</h2>
              {section.links.map(link =>
                <a class="admin-nav-item" aria-current={navKey === link.key ? 'page' : undefined} href={link.href}>{link.label}</a>
              )}
            </section>
          ))}
        </nav>
        <div class="admin-sidebar-footer">
          <a href="/" target="_blank" rel="noopener">查看网站 <span aria-hidden="true">↗</span></a>
          {showLogout && <a href="/admin/logout">退出登录</a>}
        </div>
      </aside>
      <div class="admin-workspace">
        <header class="admin-topbar">
          <div class="admin-location">
            {group && <span>{group.label} <span aria-hidden="true">/</span> </span>}
            <strong>{currentLabel}</strong>
          </div>
          <div class="admin-top-actions">
            <a href="/" target="_blank" rel="noopener">查看网站 <span aria-hidden="true">↗</span></a>
            {active !== 'media' && <a href="/admin/media" class="admin-upload">上传图片</a>}
            {showLogout && <a class="admin-signout" href="/admin/logout">退出登录</a>}
          </div>
        </header>
        <main id="admin-content" class="admin-content" tabindex="-1">
        {
          showSetupNudge && (
            <a
              href="/admin/setup"
              class="mb-6 flex items-center justify-between gap-3 rounded-md border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-gray-700 transition hover:border-brand"
            >
              <span>
                <strong class="font-semibold">完成商店设置</strong> ，填写网站名称和管理信息。
              </span>
              <span aria-hidden="true" class="text-brand">&rarr;</span>
            </a>
          )
        }
        {
          !catalogOnly && Astro.locals.settings && paymentsInDemoMode(Astro.locals.settings) && (
            <div class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
              <strong class="font-semibold">尚未配置实际支付方式。</strong> 目前仅支持<strong>演示结账</strong>，订单会标记为 <code class="rounded bg-amber-100 px-1 text-xs">demo</code>。配置实际付款方式后，仍可使用演示结账。
            </div>
          )
        }
        {
          shippingIssue && (
            <a
              href="/admin/shipping"
              class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"
            >
              <span>
                <strong class="font-semibold">配送配置无效，实体商品暂时无法结账。</strong>{' '}
                {shippingIssue.reason}
              </span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          )
        }
        {
          inventoryExceptionCount > 0 && (
            <a
              href="/admin/orders#inventory-exceptions"
              class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"
            >
              <span>
                <strong class="font-semibold">请核对库存。</strong>{' '}
                有 {inventoryExceptionCount} 个订单明细在库存预留到期后付款，库存未能足额扣减。请打开相关订单核对。
              </span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          )
        }
        <slot />
        </main>
      </div>
    </div>
  <script>
    const sidebar = document.querySelector<HTMLElement>('[data-admin-nav-list]');
    const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
    if (sidebar && current && matchMedia('(min-width: 801px)').matches) {
      const frame = sidebar.getBoundingClientRect();
      const link = current.getBoundingClientRect();
      if (link.bottom > frame.bottom) sidebar.scrollTop += link.bottom - frame.bottom + 8;
    }
  </script>
  </body>
</html>
