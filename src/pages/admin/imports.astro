---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getConfig } from '../../config';
import { publicOrigin } from '../../features/http/origin';
import { productImportConfigured } from '../../features/admin/importConfig';

if (!getConfig().features.catalogOnly) return Astro.redirect('/admin/products', 303);

const origin = publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN);
const ready = productImportConfigured(env.PRODUCT_IMPORT_TOKEN);
let result: { total: number; pending: number } | null = null;
try {
  result = await env.DB.prepare(`SELECT COUNT(*) AS total,
    COUNT(CASE WHEN p.active = 0 THEN 1 END) AS pending
    FROM product_import_sources s JOIN products p ON p.id = s.product_id`).first<{ total: number; pending: number }>();
} catch (error) {
  console.error('Imported product counts unavailable', error);
  Astro.response.status = 503;
}
---
<AdminLayout title="批量导入" active="imports">
  <div class="max-w-4xl space-y-5">
    <h1 class="text-3xl font-bold tracking-tight">批量导入</h1>
    <section class="space-y-3 rounded-xl border border-line bg-surface p-5" aria-labelledby="connection">
      <h2 id="connection" class="text-lg font-bold">采集助手连接</h2>
      <div class="flex flex-wrap items-center gap-3">
        <strong class:list={['rounded-full px-3 py-1 text-sm', ready ? 'bg-green-50 text-green-800' : 'bg-amber-50 text-amber-900']}>{ready ? '导入接口已配置' : '导入接口待配置'}</strong>
        <code class="break-all text-sm text-muted">{origin}/api/import/products</code>
      </div>
      <p class="text-sm leading-relaxed text-muted">在采集助手中填写网站地址和导入密钥。成功导入的商品会进入待上架商品库。</p>
      {!ready && <p class="text-sm text-muted">在 Cloudflare Worker 的 Secrets 中设置 <code>PRODUCT_IMPORT_TOKEN</code> 后，再连接采集助手。</p>}
    </section>
    <section class="space-y-3 rounded-xl border border-line bg-surface p-5" aria-labelledby="review">
      <h2 id="review" class="text-lg font-bold">导入与待上架</h2>
      {result ? (
        <dl class="grid grid-cols-2 gap-3 rounded-lg bg-paper p-4 text-sm">
          <div><dt>累计导入商品</dt><dd class="mt-1 text-xl font-semibold">{result.total}</dd></div>
          <div><dt>导入后待上架</dt><dd class="mt-1 text-xl font-semibold">{result.pending}</dd></div>
        </dl>
      ) : <p role="alert" class="text-sm text-red-700">暂时无法读取导入统计。</p>}
      <a href="/admin/products?status=inactive" class="inline-flex rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white">查看待上架商品</a>
    </section>
  </div>
</AdminLayout>
