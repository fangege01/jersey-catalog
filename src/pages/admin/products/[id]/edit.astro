---
import { env } from 'cloudflare:workers';
import ProductEditor from '../../../../features/products/ProductEditor.astro';
import { getProductByPublicId } from '../../../../features/products/db';
import { parsePublicId } from '../../../../features/ids/publicId';

// The route param is the prod_ public ID; numeric row ids are not accepted.
const publicId = parsePublicId(Astro.params.id, 'product');
const product = publicId ? await getProductByPublicId(env.DB, publicId) : null;

if (!product) {
  return new Response('未找到记录。', { status: 404 });
}
---

<ProductEditor mode="edit" product={product} />
