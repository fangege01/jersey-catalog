---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaPicker from '../../features/media/MediaPicker.astro';
import { setStoreImageFromMedia } from '../../features/media/db';
import { getConfig } from '../../config';
import { getStorage } from '../../features/storage';
import { mediaUrl } from '../../features/media/url';
import { uploadMedia, validateUpload } from '../../features/media/upload';
import { libraryImageLabel } from '../../features/media/seoName';
import { optimizeUpload } from '../../features/products/imageOptimize';
import { refreshStorefront } from '../../features/i18n/englishSettings';
import { appendHomeSlides, HOME_SLIDE_LIMIT, listHomeSlides, moveHomeSlide, removeHomeSlide } from '../../features/site-content/homeSlides';
import { getSetting, setSetting } from '../../features/settings/db';
import { siteImageKey } from '../../features/site-content/copy';

if (import.meta.env.MINSHOP_THEME !== 'teal') return new Response('未找到页面。', { status: 404 });
const route = '/admin/home-slides';
const fallbackKey = siteImageKey('home');
let slides = await listHomeSlides(env.DB);
let error = '';
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const action = form.get('action');
    const key = String(form.get('slot') ?? '');
    const imageKey = String(form.get('image_key') ?? '');
    if (action === 'upload') {
      const files = form.getAll('images').filter((value): value is File => value instanceof File && value.size > 0);
      if (!files.length) error = '请至少选择一张图片。';
      else if (files.length + slides.length > HOME_SLIDE_LIMIT) error = `首页最多可放 ${HOME_SLIDE_LIMIT} 张轮播图。`;
      else error = files.map(validateUpload).find(Boolean) ?? '';
      if (!error) {
        const storage = getStorage();
        const uploaded = [];
        for (const [position, file] of files.entries()) {
          const label = libraryImageLabel(file.name, '') ?? 'homepage-jersey-gallery';
          uploaded.push(await uploadMedia(env.DB, storage, await optimizeUpload(file), file.name, label, slides.length + position));
        }
        const added = await appendHomeSlides(env.DB, uploaded.map(item => item.id));
        if (added) refreshStorefront(Astro.locals.cfContext);
        if (added === files.length) return Astro.redirect(route + '?saved=1', 303);
        error = '轮播位置刚被更新。没有加入轮播的图片可以在素材库中查看。';
      }
    } else if (action === 'remove' || action === 'up' || action === 'down') {
      const changed = action === 'remove' ? await removeHomeSlide(env.DB, key, imageKey)
        : await moveHomeSlide(env.DB, key, imageKey, action === 'up' ? -1 : 1);
      if (changed) {
        refreshStorefront(Astro.locals.cfContext);
        return Astro.redirect(route + '?saved=1', 303);
      }
      error = '轮播列表已更新，请在最新列表中重试。';
    } else if (action === 'fallback') {
      const selection = form.get('image');
      if (selection === '') await setSetting(env.DB, fallbackKey, null);
      else if (typeof selection !== 'string' || selection.length > 512 ||
          !await setStoreImageFromMedia(env.DB, fallbackKey, selection)) {
        error = '请选择素材库中仍可用的图片。';
      }
      if (!error) {
        refreshStorefront(Astro.locals.cfContext);
        return Astro.redirect(route + '?saved=fallback#fallback-image', 303);
      }
    } else {
      error = '无法识别此操作。';
    }
    Astro.response.status = 400;
  } catch (cause) {
    console.error('Home slides could not be saved', cause);
    Astro.response.status = 500;
    error = '保存未完成。请检查轮播列表和素材库后重试。';
  }
  slides = await listHomeSlides(env.DB);
}
const base = getConfig().images.baseUrl;
const fallback = await getSetting(env.DB, fallbackKey);
const saved = Astro.url.searchParams.get('saved');
const btn = 'rounded-md border border-line px-3 py-2 text-sm hover:bg-paper disabled:opacity-50';
---
<AdminLayout title="首页首屏图" active="homeSlides">
  <div class="max-w-4xl space-y-5">
    <header>
      <h1 class="text-3xl font-bold">首页首屏图</h1>
      <p class="mt-2 text-sm text-muted">中英文首页共用这一组图片。上传多张后，首屏按列表顺序每 5 秒切换一张。</p>
    </header>
    {error ? <p role="alert" class="rounded-md bg-red-50 p-3 text-sm text-red-700">{error}</p>
      : (saved === '1' || saved === 'fallback') && <p role="status" class="rounded-md bg-teal-50 p-3 text-sm text-teal-800">
        {saved === 'fallback' ? '备用首屏图已更新。' : '首屏轮播图已更新。'}
      </p>}
    <section class="space-y-4 rounded-xl border border-line bg-surface p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold">上传图片</h2>
        <span class="text-sm text-muted">已添加 {slides.length} / {HOME_SLIDE_LIMIT} 张</span>
      </div>
      {slides.length < HOME_SLIDE_LIMIT && <form method="post" action={route} enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
        <input type="hidden" name="action" value="upload" />
        <input type="file" name="images" aria-label="选择轮播图片" multiple required accept="image/jpeg,image/png,image/webp,image/gif"
          class="min-w-0 max-w-full text-sm file:mr-3 file:rounded-md file:border-0 file:bg-paper file:px-3 file:py-2" />
        <button class="rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white" type="submit">上传并显示</button>
      </form>}
      <p class="text-sm text-muted">支持 JPEG、PNG、WebP 和 GIF，每张最多 5 MB。可以一次选择多张。</p>
    </section>
    <section class="space-y-4 rounded-xl border border-line bg-surface p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold">播放顺序</h2>
        <a class="text-sm text-brand underline" href="/" target="_blank" rel="noopener">查看首页</a>
      </div>
      {slides.length ? <ol class="space-y-3">
        {slides.map((slide, index) => (
          <li class="flex flex-wrap items-center gap-3 rounded-lg border border-line p-3">
            <img src={mediaUrl(slide.imageKey, base)} alt="" width="80" height="56" loading="lazy" class="h-14 w-20 rounded bg-paper object-contain" />
            <p class="min-w-0 flex-1 break-all text-sm">{index + 1}. {slide.name}</p>
            <form method="post" action={route} class="flex flex-wrap gap-2">
              <input type="hidden" name="slot" value={slide.key} />
              <input type="hidden" name="image_key" value={slide.imageKey} />
              <button class={btn} name="action" value="up" disabled={index === 0}>上移</button>
              <button class={btn} name="action" value="down" disabled={index === slides.length - 1}>下移</button>
              <button class={btn + ' text-red-700'} name="action" value="remove">移出轮播</button>
            </form>
          </li>
        ))}
      </ol> : <p class="text-sm text-muted">还没有上传轮播图。首页会显示下方的备用图或主题默认图。</p>}
      <p class="text-sm text-muted">移出轮播的图片仍可在素材库中使用。</p>
    </section>
    <form id="fallback-image" method="post" action={route} class="scroll-mt-4 space-y-3 rounded-xl border border-line bg-surface p-5">
      <input type="hidden" name="action" value="fallback" />
      <input type="hidden" name="image" value={fallback ?? ''} />
      <h2 class="text-lg font-semibold">备用首屏图</h2>
      <p class="text-sm text-muted">轮播列表为空时显示这张图。图片替代文字在「页面内容」的首页首屏设置里编辑。</p>
      <img src={fallback ? mediaUrl(fallback, base) : undefined} alt="已选备用图预览"
        data-fallback-preview hidden={!fallback} class="max-h-40 max-w-full rounded-md object-contain" />
      <div class="flex flex-wrap gap-2">
        <MediaPicker id="home-hero-fallback-picker" />
        <button type="button" data-clear-fallback class={btn}>清除选图</button>
        <button type="submit" class="rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white">保存备用图</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const fallbackForm = document.querySelector('#fallback-image')!;
  const picker = fallbackForm.querySelector('dialog');
  const input = fallbackForm.querySelector<HTMLInputElement>('input[name="image"]')!;
  const preview = fallbackForm.querySelector<HTMLImageElement>('[data-fallback-preview]')!;
  picker?.addEventListener('media:selected', event => {
    const { imageKey, url } = (event as CustomEvent<{ imageKey: string; url: string }>).detail;
    input.value = imageKey;
    preview.src = url;
    preview.hidden = false;
  });
  fallbackForm.querySelector('[data-clear-fallback]')?.addEventListener('click', () => {
    input.value = '';
    preview.removeAttribute('src');
    preview.hidden = true;
  });
</script>
