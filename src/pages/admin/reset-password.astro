---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { recoverAdminPassword, validNewAdminPassword, ADMIN_PASSWORD_MIN, ADMIN_PASSWORD_MAX } from '../../features/auth/admin';
import { verifyConfiguredTurnstile, TURNSTILE_FIELD } from '../../features/auth/turnstile';
import Turnstile from '../../features/auth/Turnstile.astro';
import { getSecret } from '../../features/secrets/store';
import '../../styles/admin.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('new_password') ?? '');
  const confirmation = String(form.get('confirm_password') ?? '');
  if (!validNewAdminPassword(password, confirmation)) {
    error = '请填写 8 至 128 位的新密码，并确认两次输入一致。';
  } else {
    const challenge = Astro.locals.settings?.turnstileEnabled === true;
    const secret = challenge ? await getSecret(env.DB, 'turnstile_secret_key') : null;
    const verified = await verifyConfiguredTurnstile(challenge, form.get(TURNSTILE_FIELD)?.toString(),
      secret, Astro.request.headers.get('CF-Connecting-IP'));
    if (!verified) {
      error = '验证失败，请重试。';
    } else if (await recoverAdminPassword(env.DB, String(form.get('recovery_code') ?? ''), password)) {
      Astro.cookies.delete('admin_session', { path: '/' });
      return Astro.redirect('/admin/login?password=updated', 303);
    } else {
      error = '恢复码无效或已使用。请检查输入。';
    }
  }
  Astro.response.status = 400;
}
const field = 'mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>重置管理员密码</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-paper px-4 py-10 text-ink antialiased">
    <main class="w-full max-w-md overflow-hidden rounded-2xl border border-line bg-surface shadow-lg">
      <header class="bg-[#102c34] px-6 py-7 text-white sm:px-8">
        <h1 class="text-2xl font-bold">重置管理员密码</h1>
      </header>
      <div class="space-y-5 p-6 sm:p-8">
        <p class="text-sm text-muted">请输入在后台「账号安全」中保存的恢复码，然后设置新密码。</p>
        {error && <p role="alert" class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>}
        <form method="post" action="/admin/reset-password" class="space-y-4">
          <label class="block text-sm">恢复码
            <input name="recovery_code" type="password" autocomplete="off" maxlength="100" required class={field} />
          </label>
          <label class="block text-sm">新密码（至少 8 位）
            <input name="new_password" type="password" autocomplete="new-password" minlength={ADMIN_PASSWORD_MIN} maxlength={ADMIN_PASSWORD_MAX} required class={field} />
          </label>
          <label class="block text-sm">确认新密码
            <input name="confirm_password" type="password" autocomplete="new-password" minlength={ADMIN_PASSWORD_MIN} maxlength={ADMIN_PASSWORD_MAX} required class={field} />
          </label>
          <div class="flex justify-center"><Turnstile /></div>
          <button type="submit" class="w-full rounded-md bg-brand px-4 py-2.5 text-sm font-medium text-white hover:bg-brand-hover">设置新密码</button>
        </form>
        <a class="inline-flex text-sm font-medium text-brand hover:underline" href="/admin/login">返回登录</a>
      </div>
    </main>
  </body>
</html>
