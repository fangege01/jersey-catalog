---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaPicker from '../../features/media/MediaPicker.astro';
import { setStoreImageFromMedia } from '../../features/media/db';
import { mediaUrl } from '../../features/media/url';
import { getSetting, setSetting } from '../../features/settings/db';
import { purgeCacheTags } from '../../features/cache/purge';
import { CACHE_TAG } from '../../features/cache/tags';
import { imageSections, readSiteCopy, siteCopyKey, siteImageEditor, siteImageKey, siteImageLabel, siteSections, type SiteSection } from '../../features/site-content/copy';
import { getConfig } from '../../config';
import { validContactEmail } from '../../features/site-content/inquiry';
import { englishCopy, EnglishTranslationError } from '../../features/i18n/english';

const sectionQuery = Astro.url.searchParams.get('section') ?? 'home';
const validSection = Object.hasOwn(siteSections, sectionQuery);
const section = validSection ? sectionQuery as SiteSection : 'home';
const locale = 'zh-CN';
const sectionInfo = siteSections[section];
const key = siteCopyKey(section, locale);
const englishKey = siteCopyKey(section, 'en');
const focus = section === 'home' ? Astro.url.searchParams.get('focus') : null;
const orderWorkflow = focus === 'process-copy';
const bottomInquiry = focus === 'bottom-inquiry';
const imageSlots = orderWorkflow ? [] : imageSections.filter(item => siteImageEditor(item) === section);
const images = await Promise.all(imageSlots.map(async slot => ({
  slot, label: siteImageLabel(slot), image: await getSetting(env.DB, siteImageKey(slot)),
})));
const focusQuery = orderWorkflow ? '&focus=process-copy' : bottomInquiry ? '&focus=bottom-inquiry' : '';
const formUrl = '/admin/site-content?section=' + section + focusQuery;
const anchor = bottomInquiry ? '#bottom-inquiry' : '';
const path = sectionInfo.url + (orderWorkflow ? '#how-to-order' : bottomInquiry ? '#bottom-cta' : '');
const workflowFields = /^(process|step)/;
const fields = Object.entries(sectionInfo.fields)
  .filter(([name]) => orderWorkflow ? workflowFields.test(name) : section !== 'contact' || !/^(body|panelTitle|point)/.test(name));
const current = await getSetting(env.DB, key);
const previous = readSiteCopy({ [key]: current ?? undefined }, section, locale);
let draft: Record<string, string> = previous;
let error = '';

if (Astro.request.method === 'POST') {
  let persisted = false;
  try {
    const form = await Astro.request.formData();
    const action = form.get('_action');
    if (!validSection) {
      error = '页面无效。';
    } else if (action === 'copy') {
      const values: Record<string, string> = {};
      for (const [name, field] of fields) {
        const raw = form.get(name);
        const value = typeof raw === 'string' ? raw.trim() : '';
        if ((!value && !('optional' in field && field.optional)) || value.length > field.max) {
          error ||= field.label + '需要填写，最多 ' + field.max + ' 个字符。';
        }
        if (name === 'contactEmail' && value && !validContactEmail(value)) error ||= '请输入有效的联系邮箱。';
        values[name] = value.slice(0, field.max);
      }
      draft = { ...previous, ...values };
      if (!error) {
        const priorEnglish = readSiteCopy({ [englishKey]: (await getSetting(env.DB, englishKey)) ?? undefined }, section, 'en');
        const limits = Object.fromEntries(fields.map(([name, field]) => [name, field.max]));
        const translated = await englishCopy(env.AI, values, limits, { source: previous, english: priorEnglish });
        const statement = 'INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = datetime(\'now\')';
        await env.DB.batch([
          env.DB.prepare(statement).bind(key, JSON.stringify(draft)),
          env.DB.prepare(statement).bind(englishKey, JSON.stringify({ ...priorEnglish, ...translated })),
        ]);
        persisted = true;
      }
    } else if (action === 'image') {
      const slot = imageSlots.find(item => item === (form.get('slot') ?? section));
      const imageKey = slot ? siteImageKey(slot) : null;
      const selection = form.get('image');
      if (!imageKey) {
        error = '无法识别图片位置。';
      } else if (selection === '') {
        await setSetting(env.DB, imageKey, '');
        persisted = true;
      } else if (typeof selection === 'string' && selection.length <= 512 &&
          await setStoreImageFromMedia(env.DB, imageKey, selection)) {
        persisted = true;
      } else {
        error = '请选择素材库中仍可用的图片。';
      }
    } else {
      error = '无法识别此操作。';
    }

    if (persisted) {
      await purgeCacheTags([CACHE_TAG.shell, CACHE_TAG.catalog]);
      return Astro.redirect(formUrl + '&saved=1' + anchor, 303);
    }
    Astro.response.status = 400;
  } catch (cause) {
    if (cause instanceof EnglishTranslationError) {
      Astro.response.status = 503;
      error = cause.message;
    } else {
      console.error('Site content save failed', { section, cause });
      Astro.response.status = 500;
      error = persisted ? '内容已保存，前台缓存刷新失败。请稍后刷新查看。' : '保存失败，请稍后重试。';
    }
  }
}
const homeGroups = [
  { id: 'hero-copy', title: '首屏与询价按钮', pattern: /^(eyebrow|hero|browseCta|quoteCta)/ },
  { id: 'listing-copy', title: '精选球衣与分类', pattern: /^(featured|category|emptyFeatured)/ },
  { id: 'service-copy', title: '采购与定制', pattern: /^(options|retail|team|wholesale|custom)/ },
  { id: 'supply-copy', title: '供应与质量', pattern: /^supply/ },
  { id: 'process-copy', title: '订购流程', pattern: workflowFields },
  { id: 'faq-copy', title: '常见问题', pattern: /^(faq|question|answer)/ },
  { id: 'bottom-inquiry', title: '底部询盘设置', pattern: /^closing/ },
  { id: 'page-seo', title: '首页 SEO', pattern: /^seo/ },
];
const contactGroups = [
  { id: 'contact-hero', title: '联系页首屏与 SEO', pattern: /^(title|kicker|intro|seo)/ },
  { id: 'contact-form', title: '询盘表单', pattern: /^(form|field|messagePlaceholder|chooseOption)/ },
  { id: 'contact-info', title: '联系信息与运输方式', pattern: /^(info|contact|shipping|cta)/ },
  { id: 'floating-contact', title: '悬浮联系入口', pattern: /^floating/ },
  { id: 'contact-image', title: '社交分享图片', pattern: /^imageAlt$/ },
];
const factoryGroups = [
  { id: 'factory-hero', title: '首屏与搜索优化', pattern: /^(title|intro|imageAlt|seo)/ },
  { id: 'factory-overview', title: '供应概览', pattern: /^(panelTitle|body)/ },
  { id: 'factory-production', title: '生产流程、定制和质量', pattern: /^(production|customization|point2)/ },
  { id: 'factory-stock', title: '备货、包装与发运', pattern: /^(point[13]|warehouseAlt)/ },
  { id: 'factory-gallery', title: '供应实拍与服务对象', pattern: /^(gallery|audience)/ },
  { id: 'factory-quote', title: '底部询盘与按钮', pattern: /^(closing|quoteLabel|browseLabel|cta)/ },
];
const groups = section === 'home' ? homeGroups : section === 'contact' ? contactGroups : section === 'factory' ? factoryGroups : null;
const editorGroups = groups ? groups.filter(group => !orderWorkflow || group.id === 'process-copy').map(group => ({
  ...group, fields: fields.filter(([name]) => group.pattern.test(name)),
})) : [{ id: 'page-copy', title: sectionInfo.label, fields }];
const fieldClass = 'mt-1 block w-full rounded-md border border-line bg-paper p-2.5 text-sm';
const buttonClass = 'inline-flex min-h-10 items-center rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white';
const descriptions: Record<SiteSection, string> = {
  global: '调整五个主菜单的显示文字和页脚介绍。站点名称和 Logo 在「站点设置」修改。',
  home: '编辑首屏、精选商品、分类、采购说明、供应介绍、询价流程、FAQ 和底部按钮。精选商品与分类来自已上架商品及分类库。',
  products: '编辑目录介绍、SEO 和空列表文案。商品详情和图片可在「商品管理」编辑。',
  factory: '编辑供应页各区块，并从素材库分别选择首图和备货图。前台的实拍区使用这两张图。',
  about: '编辑品牌介绍、服务对象和配图。',
  contact: '编辑联系页、表单按钮和运输信息。WhatsApp 号码在「WhatsApp 管理」修改，收到的表单在「询盘管理」查看。',
};
---
<AdminLayout title={orderWorkflow ? '首页菜单' : bottomInquiry ? '底部询盘设置' : section === 'contact' ? '联系页面设置' : '网站内容'}
  active={orderWorkflow ? 'orderWorkflow' : bottomInquiry ? 'bottomInquiry' : section === 'contact' ? 'contactPage' : section === 'factory' ? 'factorySupply' : 'siteContent'}>
  <div class="mx-auto max-w-4xl space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="font-serif text-3xl">{orderWorkflow ? '首页菜单' : '网站内容'}</h1>
      <a class="text-sm underline" href={path} target="_blank" rel="noopener">打开当前前台页面</a>
    </div>
    <nav aria-label="网站页面" class="flex flex-wrap gap-2">
      {Object.entries(siteSections).map(([name, item]) => <a class:list={['rounded-md border border-line px-3 py-2 text-sm', name === section && 'bg-brand text-white']}
        href={'/admin/site-content?section=' + name}
        aria-current={name === section ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    {!orderWorkflow && <p class="text-sm text-muted">{descriptions[section]}</p>}
    <p class="text-sm text-muted">可填中文或英文。中文保存时自动生成英文文案，英文按原文显示。</p>
    {section === 'products' && <div class="flex flex-wrap gap-4 text-sm">
      <a class="underline" href="/admin/products">商品管理</a><a class="underline" href="/admin/categories">分类管理</a>
    </div>}
    {section === 'global' && <a class="block text-sm underline" href="/admin/settings">修改站点名称和 Logo</a>}
    {section === 'contact' && <a class="block text-sm underline" href="/admin/whatsapp">修改全站 WhatsApp 号码</a>}
    {error ? <p role="alert" class="text-sm font-medium text-red-700">{error}</p> :
      Astro.url.searchParams.get('saved') === '1' && <p role="status" class="text-sm font-medium text-green-700">已保存并同步前台。</p>}
    {images.map(({slot, label, image}) => <form method="POST" action={formUrl} data-site-image-form class="space-y-3 rounded-xl border border-line bg-surface p-5">
      <input type="hidden" name="_action" value="image" />
      <input type="hidden" name="slot" value={slot} />
      <input type="hidden" name="image" value={image ?? ''} />
      <h2 class="font-semibold">{label}</h2>
      <p class="text-sm text-muted">中英文页面共用图片，替代文字在下方编辑。</p>
      <img src={image ? mediaUrl(image, getConfig().images.baseUrl) : undefined} alt="已选配图预览" data-site-image-preview
        hidden={!image} class="max-h-48 max-w-full rounded-md object-contain" />
      <div class="flex flex-wrap gap-2">
        <MediaPicker id={'site-content-image-' + slot} />
        <button type="button" data-clear-site-image class="rounded-md border border-line px-3 text-sm">清除选图</button>
        <button class={buttonClass}>保存图片</button>
      </div>
    </form>)}
    <form method="POST" action={formUrl} class="space-y-5 rounded-xl border border-line bg-surface p-5">
      <input type="hidden" name="_action" value="copy" />
      {!orderWorkflow && <h2 class="font-semibold">{sectionInfo.label}</h2>}
      {editorGroups.length > 1 && <nav aria-label="页面编辑区块" class="flex flex-wrap gap-2">
        {editorGroups.map(group => <a class="rounded-md border border-line bg-paper px-3 py-1 text-xs font-medium hover:border-brand" href={'#' + group.id}>{group.title}</a>)}
      </nav>}
      {editorGroups.map(group => <fieldset id={group.id} class="scroll-mt-4 rounded-lg border border-line p-4">
        <legend class="px-2 text-sm font-bold">{group.title}</legend>
        <div class="grid gap-4 sm:grid-cols-2">
        {group.fields.map(([name, field]) => <label class:list={['block text-sm font-medium', field.max > 160 && 'sm:col-span-2']}>{field.label}
          {field.max > 160 && name !== 'contactEmail' ? <textarea rows="3" class={fieldClass} name={name} maxlength={field.max} required>{draft[name]}</textarea> :
            <input type={name === 'contactEmail' ? 'email' : 'text'} class={fieldClass} name={name} value={draft[name]} maxlength={field.max}
              required={!('optional' in field && field.optional)} />}
        </label>)}
        </div>
      </fieldset>)}
      <button class={buttonClass}>保存并同步前台</button>
    </form>
  </div>
</AdminLayout>

<script>
  for (const form of document.querySelectorAll('[data-site-image-form]')) {
    const picker = form.querySelector('dialog');
    const input = form.querySelector<HTMLInputElement>('input[name="image"]');
    const preview = form.querySelector<HTMLImageElement>('[data-site-image-preview]');
    if (!input || !preview) continue;
    picker?.addEventListener('media:selected', (event) => {
      const { imageKey, url } = (event as CustomEvent<{ imageKey: string; url: string }>).detail;
      input.value = imageKey;
      preview.src = url;
      preview.hidden = false;
    });
    form.querySelector('[data-clear-site-image]')?.addEventListener('click', () => {
      input.value = '';
      preview.removeAttribute('src');
      preview.hidden = true;
    });
  }
</script>
