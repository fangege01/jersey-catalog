---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CACHE_TAG } from '../../features/cache/tags';
import { purgeCacheTags } from '../../features/cache/purge';
import { prepareEnglishSave } from '../../features/i18n/english';
import { refreshStorefront, syncSiteEnglish } from '../../features/i18n/englishSettings';
import { readSiteCopy, siteCopyKey, siteSections } from '../../features/site-content/copy';
import { footerFields, footerLinkKeys, readFooterSettings } from '../../features/site-content/footerSettings';
import { validContactEmail } from '../../features/site-content/inquiry';
import {
  getMenus,
  MENU_CAPS,
  MAX_MENU_LABEL,
  isMenuTargetType,
  SINGLETON_LABELS,
  type MenuLocation,
  type MenuTargetType,
} from '../../features/navigation/db';
import {
  targetChoices,
  unavailableReason,
  TARGET_TYPE_LABELS,
  PICKER_LIMIT,
} from '../../features/navigation/admin';

const url = Astro.url;
let error = url.searchParams.get('error');
const saved = url.searchParams.get('saved');
const teal = import.meta.env.MINSHOP_THEME === 'teal';
const settings = Astro.locals.settings;
const footerOptions = readFooterSettings(settings?.footerOptions);
if (teal && Astro.request.method === 'GET' && url.searchParams.get('footer-sync') === '1') {
  return Response.json({ status: footerOptions.syncStatus }, { headers: { 'cache-control': 'private, no-store' } });
}
const sharedFields = {
  footer: siteSections.global.fields.footer,
  contactAddress: siteSections.contact.fields.contactAddress,
  contactEmail: siteSections.contact.fields.contactEmail,
};
const sharedCopy = (locale: 'en' | 'zh-CN') => {
  const global = readSiteCopy(settings?.siteContent, 'global', locale);
  const contact = readSiteCopy(settings?.siteContent, 'contact', locale);
  return { footer: global.footer, contactAddress: contact.contactAddress, contactEmail: contact.contactEmail };
};
const priorSource = { ...sharedCopy('zh-CN'), ...footerOptions.source };
const priorEnglish = { ...sharedCopy('en'), ...footerOptions.english };
let footerDraft: Record<string, string> = priorSource;
let hiddenLinks = footerOptions.hidden;

if (teal && Astro.request.method === 'POST') {
  let persisted = false;
  try {
    const form = await Astro.request.formData();
    if (form.get('_action') !== 'footer-content') {
      error = '无法识别此操作。';
    } else {
      const specs = Object.entries({ ...sharedFields, ...footerFields });
      footerDraft = Object.fromEntries(specs.map(([key]) => {
        const value = form.get(key);
        return [key, typeof value === 'string' ? value.trim() : ''];
      }));
      hiddenLinks = footerLinkKeys.filter(key => form.get('show_' + key) !== '1');
      const invalidLength = specs.find(([key, field]) => footerDraft[key].length > field.max);
      if (invalidLength) error = invalidLength[1].label + '最多可填写 ' + invalidLength[1].max + ' 字。';
      else if (!footerDraft.footer || !footerDraft.contactAddress) error = '请填写页脚简介和联系地址。';
      else if (footerDraft.contactEmail && !validContactEmail(footerDraft.contactEmail)) error = '请输入有效的联系邮箱。';
      if (!error) {
        const limits = Object.fromEntries(specs.map(([key, field]) => [key, field.max]));
        const { fallback, pending } = prepareEnglishSave(footerDraft, {
          source: priorSource, english: priorEnglish,
        }, footerOptions.retry);
        const pick = (data: Record<string, string>) => ({
          global: { footer: data.footer },
          contact: { contactAddress: data.contactAddress, contactEmail: data.contactEmail },
          footer: Object.fromEntries(Object.keys(footerFields).map(key => [key, data[key]])),
        });
        const source = pick(footerDraft);
        const english = pick(fallback);
        const keys = Object.keys(pending);
        const options = { source: source.footer, english: english.footer, hidden: hiddenLinks };
        const value = JSON.stringify(keys.length ? { ...options, sync: { status: 'pending', keys, id: crypto.randomUUID() } } : options);
        const sharedPatch = `
          INSERT INTO settings (key,value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET
            value=json_patch(CASE WHEN json_valid(settings.value) THEN
              CASE WHEN json_type(settings.value)='object' THEN settings.value ELSE '{}' END
              ELSE '{}' END, excluded.value),
            updated_at=datetime('now')`;
        await env.DB.batch([
          env.DB.prepare(sharedPatch).bind(siteCopyKey('global', 'zh-CN'), JSON.stringify(source.global)),
          env.DB.prepare(sharedPatch).bind(siteCopyKey('global', 'en'), JSON.stringify(english.global)),
          env.DB.prepare(sharedPatch).bind(siteCopyKey('contact', 'zh-CN'), JSON.stringify(source.contact)),
          env.DB.prepare(sharedPatch).bind(siteCopyKey('contact', 'en'), JSON.stringify(english.contact)),
          env.DB.prepare(`INSERT INTO settings (key,value) VALUES ('footer_options',?)
            ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=datetime('now')`)
            .bind(value),
        ]);
        persisted = true;
        refreshStorefront(Astro.locals.cfContext);
        syncSiteEnglish(Astro.locals.cfContext, env.AI, pending, limits, async translated => {
          const final = pick({ ...fallback, ...translated });
          const guardedPatch = `UPDATE settings SET value=json_patch(value,?),updated_at=datetime('now')
            WHERE key=? AND EXISTS (SELECT 1 FROM settings WHERE key='footer_options' AND value=?)
            AND EXISTS (SELECT 1 FROM settings WHERE key=? AND json_extract(value,'$.footer')=?)
            AND EXISTS (SELECT 1 FROM settings WHERE key=?
              AND json_extract(value,'$.contactAddress')=? AND json_extract(value,'$.contactEmail')=?)`;
          const globalZh = siteCopyKey('global', 'zh-CN');
          const contactZh = siteCopyKey('contact', 'zh-CN');
          const guard = [value, globalZh, source.global.footer, contactZh, source.contact.contactAddress, source.contact.contactEmail] as const;
          const finish = guardedPatch.replace('value=json_patch(value,?)', 'value=?');
          const results = await env.DB.batch([
            env.DB.prepare(guardedPatch).bind(JSON.stringify(final.global), siteCopyKey('global', 'en'), ...guard),
            env.DB.prepare(guardedPatch).bind(JSON.stringify(final.contact), siteCopyKey('contact', 'en'), ...guard),
            env.DB.prepare(finish).bind(JSON.stringify({ ...options, english: final.footer }), 'footer_options', ...guard),
          ]);
          if (results[2].meta.changes) await purgeCacheTags([CACHE_TAG.shell, CACHE_TAG.catalog]);
          else await env.DB.prepare("UPDATE settings SET value=json_set(value,'$.sync.status','failed') WHERE key='footer_options' AND value=?").bind(value).run();
        }, () => env.DB.prepare("UPDATE settings SET value=json_set(value,'$.sync.status','failed') WHERE key='footer_options' AND value=?").bind(value).run());
        return Astro.redirect('/admin/navigation?saved=footer#footer-content', 303);
      }
    }
    Astro.response.status = 400;
  } catch (cause) {
    console.error('Footer settings could not be saved', cause);
    Astro.response.status = 500;
    error = persisted ? '中文已保存。请刷新查看英文同步状态。' : '页脚设置保存失败，请重试。';
  }
}

// The picker is server-rendered and searchable rather than a giant <select>: a
// store with thousands of products would otherwise put every one of them into
// this page's HTML, and a bare cap would make anything past it unselectable.
const rawType = url.searchParams.get('target_type');
const pickerType: MenuTargetType = isMenuTargetType(rawType) ? rawType : 'page';
const pickerLocation: MenuLocation = teal || url.searchParams.get('location') === 'footer' ? 'footer' : 'header';
const pickerQuery = url.searchParams.get('q') ?? '';

const homePage = Astro.locals.settings?.homePage ?? null;
const menus = await getMenus(env.DB, homePage);

// Every object type's options are fetched and rendered up front so switching the
// type <select> is instant — CSS reveals the matching picker instead of a page
// reload. Three bounded reads on an admin page, not the storefront hot path.
const OBJECT_TYPES = ['page', 'product', 'category'] as const satisfies readonly MenuTargetType[];
// `q` applies ONLY to the type it was typed for. Applying it to all three would
// mean searching "beanie" under Products and then switching to Pages shows a
// page list mysteriously filtered by a product search.
const choiceList = await Promise.all(
  OBJECT_TYPES.map((t) => targetChoices(env.DB, t, t === pickerType ? pickerQuery : '')),
);
const choices = Object.fromEntries(
  OBJECT_TYPES.map((t, i) => [t, choiceList[i]]),
) as Record<(typeof OBJECT_TYPES)[number], (typeof choiceList)[number]>;
const truncated = OBJECT_TYPES.filter((t) => choices[t].remaining > 0);

const isSingletonType = pickerType === 'home' || pickerType === 'catalog';

// "Search all" only matters when the list is capped — below the cap the live
// filter is already complete. Rendered hidden from the server in that case:
// the script used to hide it on load instead, which flashed the button into
// view on every page load before the JS ran.
const searchAllNeeded = !isSingletonType && choices[pickerType].remaining > 0;

// Nothing selectable means nothing to add. Computed server-side so the button is
// already correct without JavaScript; the script keeps it in step as the live
// filter narrows the list.
const nothingToAdd = !isSingletonType && choices[pickerType].options.length === 0;

// What a blank label will fall back to, for the placeholder. Server-rendered for
// the initial selection; the script keeps it in step as the merchant picks.
const initialDefaultLabel = isSingletonType
  ? SINGLETON_LABELS[pickerType]
  : (choices[pickerType].options[0]?.name ?? '');

// Home and Catalog both resolve to '/' until the home page is pointed elsewhere,
// so a store in that state can end up with two identical links. Warn rather than
// suppress one at render time: silently dropping it would make this list disagree
// with the storefront, which is worse than a duplicate.
const bothRootLinks = (loc: MenuLocation) =>
  !teal && !homePage &&
  menus[loc].some((i) => i.targetType === 'home') &&
  menus[loc].some((i) => i.targetType === 'catalog');

const locations: { key: MenuLocation; title: string; note: string }[] = [
  {
    key: 'header',
    title: '页眉',
    note: `最多 ${MENU_CAPS.header} 项。`,
  },
  { key: 'footer', title: '页脚', note: `最多 ${MENU_CAPS.footer} 项。` },
];
const visibleLocations = teal ? locations.filter(({ key }) => key === 'footer') : locations;
const menuDefaults = readSiteCopy(settings?.siteContent, 'global', 'zh-CN');
const footerPlaceholders = {
  productsTitle: '产品', quickTitle: '快速链接', contactTitle: '联系方式',
  products: menuDefaults.navProducts, factory: menuDefaults.navFactory, about: menuDefaults.navAbout, contact: menuDefaults.navContact,
};
const inputClass = 'mt-1 block w-full rounded-md border border-line bg-paper p-2.5 text-sm';
---
<AdminLayout title={teal ? '页脚设置' : '导航'} active="navigation">
  <div class="mb-8">
    <h1 class="font-serif text-3xl tracking-tight">{teal ? '页脚设置' : '导航'}</h1>
    <p class="mt-2 text-sm text-gray-500">
      {teal ? '管理每个页面底部的品牌介绍、栏目、链接与联系方式。' : '设置前台页眉和页脚的菜单。'}
    </p>
  </div>

  {
    error && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {error}
      </p>
    )
  }
  {
    saved && !error && (
      <p class="mb-6 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
        {saved === 'footer' ? '页脚设置已保存。' : '导航已更新。'}
      </p>
    )
  }

  {teal && <form id="footer-content" method="POST" action="/admin/navigation#footer-content" class="mb-8 space-y-5 rounded-xl border border-line bg-surface p-5">
    <input type="hidden" name="_action" value="footer-content" />
    {footerOptions.syncStatus && <p role="status" class="text-sm text-muted" data-footer-sync={footerOptions.syncStatus}>
      {footerOptions.syncStatus === 'pending' ? '中文已保存，英文正在同步。' : '中文已保存，英文暂未同步。再次保存可重试。'}
    </p>}
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-serif text-xl">页脚内容</h2>
      <a class="text-sm underline" href="/#site-footer" target="_blank" rel="noopener">查看前台页脚</a>
    </div>
    <label class="block text-sm font-medium">品牌介绍
      <textarea name="footer" class={inputClass} rows="3" maxlength="600" required>{footerDraft.footer}</textarea>
    </label>
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="text-sm">联系地址<input name="contactAddress" class={inputClass} maxlength="160" value={footerDraft.contactAddress} required /></label>
      <label class="text-sm">联系邮箱（选填）<input name="contactEmail" class={inputClass} type="email" maxlength="254" value={footerDraft.contactEmail} /></label>
    </div>
    <p class="text-sm text-muted">联系地址和邮箱与联系页面共用。<a class="underline" href="/admin/settings">修改全站名称或 Logo</a> · <a class="underline" href="/admin/whatsapp">修改全站 WhatsApp 号码</a></p>
    <fieldset class="grid gap-3 rounded-lg border border-line p-3 sm:grid-cols-3">
      <legend class="px-1 text-sm font-medium">栏目标题</legend>
      {(['productsTitle','quickTitle','contactTitle'] as const).map(key => <label class="text-sm">{footerFields[key].label}
        <input name={key} class={inputClass} maxlength={footerFields[key].max} value={footerDraft[key]} placeholder={footerPlaceholders[key]} />
      </label>)}
    </fieldset>
    <fieldset class="space-y-3 rounded-lg border border-line p-3">
      <legend class="px-1 text-sm font-medium">默认链接</legend>
      <p class="text-sm text-muted">栏目标题和链接名称可留空，前台会使用默认文字。</p>
      <div class="grid gap-3 sm:grid-cols-2">
        {footerLinkKeys.map(key => <div class="rounded-lg border border-line bg-paper p-3">
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name={'show_' + key} value="1" checked={!hiddenLinks.includes(key)} /> 显示{footerPlaceholders[key]}</label>
          <label class="mt-2 block text-sm">{footerFields[key].label}
            <input name={key} class={inputClass} maxlength={footerFields[key].max} value={footerDraft[key]} placeholder={footerPlaceholders[key]} />
          </label>
        </div>)}
      </div>
    </fieldset>
    <button type="submit" class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-hover">保存页脚设置</button>
  </form>}
  <section class="mb-10 rounded-lg border border-line bg-white/60 p-5">
    <h2 class="mb-4 font-serif text-xl tracking-tight">新增导航项</h2>

    {/* ONE form. Every type's picker is rendered up front and revealed by CSS as
        the type <select> changes, so choosing a type costs no round trip.
        Search still needs the server, so its button overrides the method for
        that submit only (formmethod/formaction) — same form, no duplicate
        controls to keep in sync, and it all works without JavaScript. */}
    <form
      method="POST"
      action="/api/admin/navigation"
      data-add-item
      class="flex flex-col gap-4"
    >
      {/* Two rows on purpose. The picker and search change width with the
          selected type, so keeping "Add to" and the Add button on the same row
          made them slide left and right as you switched type — the primary
          action should not move under the cursor.
          min-h holds the row's height when Home/Catalog hide both the picker and
          the search, which would otherwise nudge the second row up by 2px. */}
      <div class="flex min-h-[3.65rem] flex-wrap items-end gap-3">
      <label class="text-xs uppercase tracking-wider text-gray-500">
        类型
        <select
          name="target_type"
          class="mt-1 block rounded-md border border-line bg-white px-3 py-2 text-sm normal-case tracking-normal text-gray-900"
        >
          {
            (Object.keys(TARGET_TYPE_LABELS) as MenuTargetType[]).map((t) => (
              <option value={t} selected={t === pickerType}>
                {TARGET_TYPE_LABELS[t]}
              </option>
            ))
          }
        </select>
      </label>

      <div data-target-search class="flex-col text-xs uppercase tracking-wider text-gray-500">
        <label for="nav-target-search">搜索</label>
        <div class="mt-1 flex gap-2">
          <input
            id="nav-target-search"
            type="search"
            name="q"
            value={pickerQuery}
            placeholder="按名称筛选"
            class="block w-40 rounded-md border border-line px-3 py-2 text-sm normal-case tracking-normal"
          />
          <button
            type="submit"
            formmethod="get"
            formaction="/admin/navigation"
            hidden={!searchAllNeeded}
            class="rounded-md border border-line px-3 py-2 text-xs uppercase tracking-wider hover:border-brand hover:text-brand"
          >
            搜索全部
          </button>
        </div>
      </div>

      {/* One picker per object type, all present, all but one hidden. Hidden
          fields still submit, hence the per-type name — the endpoint reads only
          target_id_<target_type>. No `required`: a hidden required control makes
          the form unsubmittable. */}
      {
        OBJECT_TYPES.map((t) => (
          <label
            data-target-picker={t}
            data-truncated={choices[t].remaining > 0 ? '1' : '0'}
            class="flex-col text-xs uppercase tracking-wider text-gray-500"
          >
            {TARGET_TYPE_LABELS[t]}
            <select
              name={`target_id_${t}`}
              class="mt-1 block w-56 rounded-md border border-line bg-white px-3 py-2 text-sm normal-case tracking-normal text-gray-900"
            >
              {choices[t].options.length === 0 && (
                <option value="">
                  {pickerQuery ? '暂无匹配' : '暂无可用项目'}
                </option>
              )}
              {choices[t].options.map((o) => (
                <option value={o.public_id}>{o.name}</option>
              ))}
            </select>
          </label>
        ))
      }
      </div>

      <div class="flex flex-wrap items-end gap-3">
        <label class="text-xs uppercase tracking-wider text-gray-500">
        显示名称（可选）
        <input
          type="text"
          name="label"
          maxlength={MAX_MENU_LABEL}
          data-label-input
          placeholder={
            initialDefaultLabel ? `默认使用「${initialDefaultLabel}」` : '默认使用原名称'
          }
          class="mt-1 block rounded-md border border-line px-3 py-2 text-sm normal-case tracking-normal"
        />
      </label>

      {teal ? <input type="hidden" name="location" value="footer" /> : <label class="text-xs uppercase tracking-wider text-gray-500">
        添加到
        <select
          name="location"
          class="mt-1 block rounded-md border border-line bg-white px-3 py-2 text-sm normal-case tracking-normal text-gray-900"
        >
          <option value="header" selected={pickerLocation === 'header'}>页眉</option>
          <option value="footer" selected={pickerLocation === 'footer'}>页脚</option>
        </select>
      </label>}

      <button
        type="submit"
        name="_action"
        value="add"
        data-add-button
        disabled={nothingToAdd}
        title={nothingToAdd ? '没有匹配项，请清除筛选或扩大搜索范围' : undefined}
        class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-brand"
      >
        添加
        </button>
      </div>
    </form>

    {
      truncated.length > 0 && (
        <p class="mt-3 text-xs text-gray-500">
          {truncated
            .map((t) => `${TARGET_TYPE_LABELS[t]}：显示 ${PICKER_LIMIT} 项，共 ${choices[t].options.length + choices[t].remaining} 项`)
            .join(' · ')}
          。输入内容可筛选当前列表，也可搜索全部。
        </p>
      )
    }
  </section>

  <div class="grid gap-10 lg:grid-cols-2">
    {
      visibleLocations.map((loc) => (
        <section class="min-w-0">
          <div class="mb-1 flex items-baseline justify-between">
            <h2 class="font-serif text-xl tracking-tight">{loc.title}</h2>
            <span class="text-xs text-gray-400">
              {menus[loc.key].length} / {MENU_CAPS[loc.key]}
            </span>
          </div>
          <p class="mb-4 text-xs text-gray-500">{loc.note}</p>

          {bothRootLinks(loc.key) && (
            <p class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
              首页和商品目录目前都指向 <code>/</code>。设置自定义首页后，两者会指向不同页面。
            </p>
          )}

          {menus[loc.key].length === 0 ? (
            <p class="rounded-md border border-dashed border-line py-8 text-center text-sm text-gray-500">
              暂无项目。
            </p>
          ) : (
            <ul data-menu-list={loc.key} class="divide-y divide-line border-y border-line">
              {menus[loc.key].map((item, index) => {
                const reason = unavailableReason(item);
                return (
                  <li data-menu-item={item.publicId} class="flex min-w-0 items-start gap-3 py-3">
                    {/* The grip starts mouse drag sorting. aria-hidden because Up/Down are the
                        accessible, no-JS way to do the same thing. */}
                    <span
                      data-handle
                      aria-hidden="true"
                      class="mt-1 hidden shrink-0 cursor-grab select-none text-gray-300 hover:text-gray-500 sm:block"
                    >
                      <svg width="12" height="20" viewBox="0 0 12 20" fill="currentColor" class="pointer-events-none">
                        <circle cx="3" cy="5" r="1.5" />
                        <circle cx="9" cy="5" r="1.5" />
                        <circle cx="3" cy="10" r="1.5" />
                        <circle cx="9" cy="10" r="1.5" />
                        <circle cx="3" cy="15" r="1.5" />
                        <circle cx="9" cy="15" r="1.5" />
                      </svg>
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex min-w-0 flex-wrap items-center gap-2">
                        <span class="truncate text-sm font-medium">
                          {item.text || 'Untitled'}
                        </span>
                        <span class="rounded bg-gray-100 px-1.5 py-0.5 text-[10px] uppercase tracking-wider text-gray-500">
                          {TARGET_TYPE_LABELS[item.targetType]}
                        </span>
                      </div>
                      {reason ? (
                        <p class="mt-1 text-xs text-amber-700">{reason}</p>
                      ) : (
                        <p class="mt-1 truncate text-xs text-gray-400">{item.href}</p>
                      )}

                      {/* Renaming is folded away behind a disclosure. An always-on
                          input per row gave no clue what it did — it read as much
                          like a search box as a rename — and a 50-item footer meant
                          50 unexplained inputs. <details> states the intent in its
                          own summary and needs no JavaScript. */}
                      <details class="admin-rename mt-1">
                        <summary class="inline-flex cursor-pointer list-none text-xs text-gray-500 hover:text-brand">
                          编辑链接文字
                        </summary>
                        <form
                          method="POST"
                          action="/api/admin/navigation"
                          class="mt-2 rounded-md bg-gray-50 p-2"
                        >
                          <input type="hidden" name="_action" value="label" />
                          <input type="hidden" name="id" value={item.publicId} />
                          <label
                            for={`label-${item.publicId}`}
                            class="block text-[10px] uppercase tracking-wider text-gray-500"
                          >
                            链接文字
                          </label>
                          <div class="mt-1 flex gap-2">
                            <input
                              id={`label-${item.publicId}`}
                              type="text"
                              name="label"
                              value={item.label ?? ''}
                              maxlength={MAX_MENU_LABEL}
                              placeholder={item.targetName ?? '链接文字'}
                              class="min-w-0 flex-1 rounded border border-line bg-white px-2 py-1 text-xs focus:border-brand focus:outline-none"
                            />
                            <button
                              type="submit"
                              class="rounded border border-line px-2 py-1 text-xs hover:border-brand hover:text-brand"
                            >
                              保存
                            </button>
                          </div>
                          <p class="mt-1 text-[10px] text-gray-500">
                            仅修改此导航菜单显示的文字
                            {item.targetName ? ` — leave blank to use “${item.targetName}”` : ''}.
                          </p>
                        </form>
                      </details>
                    </div>

                    <div class="flex flex-none items-center gap-1">
                      {/* Up/Down, not drag-and-drop: works with no JavaScript.
                          The gallery's drag pattern can be layered on later. */}
                      <form method="POST" action="/api/admin/navigation">
                        <input type="hidden" name="_action" value="move" />
                        <input type="hidden" name="id" value={item.publicId} />
                        <input type="hidden" name="direction" value="up" />
                        <button
                          type="submit"
                          aria-label="上移"
                          disabled={index === 0}
                          class="px-1 text-gray-400 hover:text-brand disabled:invisible"
                        >
                          ↑
                        </button>
                      </form>
                      <form method="POST" action="/api/admin/navigation">
                        <input type="hidden" name="_action" value="move" />
                        <input type="hidden" name="id" value={item.publicId} />
                        <input type="hidden" name="direction" value="down" />
                        <button
                          type="submit"
                          aria-label="下移"
                          disabled={index === menus[loc.key].length - 1}
                          class="px-1 text-gray-400 hover:text-brand disabled:invisible"
                        >
                          ↓
                        </button>
                      </form>
                      {/* Confirmed: this is the only destructive control on the
                          page, it sits one pixel from the arrows, and there is no
                          undo. The other delete sites in admin all confirm. */}
                      <form
                        method="POST"
                        action="/api/admin/navigation"
                        onsubmit={`return confirm('确定从${loc.title}菜单移除${(item.text || '此项目').replace(/'/g, "\\'")}？')`}
                      >
                        <input type="hidden" name="_action" value="remove" />
                        <input type="hidden" name="id" value={item.publicId} />
                        <button
                          type="submit"
                          aria-label={`移除${item.text || '此项目'}`}
                          class="px-1 text-gray-400 hover:text-red-600"
                        >
                          ×
                        </button>
                      </form>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))
    }
  </div>


<script>
  import { enableHandleReorder } from '../../features/admin/handleReorder';
  const footerSync = document.querySelector<HTMLElement>('[data-footer-sync="pending"]');
  if (footerSync) {
    let attempts = 0;
    const check = async () => {
      try {
        const response = await fetch('/admin/navigation?footer-sync=1', { cache: 'no-store' });
        if (!response.ok) throw new Error('Could not read sync status');
        const { status } = await response.json() as { status?: string };
        if (status !== 'pending') {
          footerSync.textContent = status === 'failed' ? '中文已保存，英文暂未同步。再次保存可重试。' : '英文文案已同步。';
          return;
        }
      } catch { /* A temporary connection failure can be checked again. */ }
      if (++attempts < 16) setTimeout(check, 1500);
      else footerSync.textContent = '中文已保存。请刷新查看英文同步状态，或再次保存重试。';
    };
    setTimeout(check, 1000);
  }
  // Progressive enhancement over a form that already works without it.
  //
  // Baseline: pick a type, pick from its (server-filtered) <select>, submit —
  // and "Search all" round-trips for lists too long to ship whole.
  // Enhanced: typing filters the visible list instantly, and switching type
  // clears the box, because a query typed for Products means nothing for Pages.
  //
  // The filter only claims completeness when the list is NOT truncated. Over a
  // capped list it would report "暂无匹配" for a product that exists just past
  // the cap, so "Search all" stays visible in exactly that case.
  //
  // Casts rather than querySelector<T> generics: this project's global `Element`
  // resolves to the Workers HTMLRewriter Element, whose remove() returns Element
  // instead of void, so DOM element types fail that generic's constraint.
  const form = document.querySelector('[data-add-item]') as HTMLFormElement | null;
  const typeSel = form?.querySelector('select[name="target_type"]') as HTMLSelectElement | null;
  const search = form?.querySelector('input[name="q"]') as HTMLInputElement | null;
  const searchAll = form?.querySelector('button[formmethod="get"]') as HTMLButtonElement | null;
  const labelInput = form?.querySelector('[data-label-input]') as HTMLInputElement | null;
  const addButton = form?.querySelector('[data-add-button]') as HTMLButtonElement | null;

  if (form && typeSel && search && searchAll) {
    type Picker = {
      select: HTMLSelectElement;
      truncated: boolean;
      all: { value: string; text: string }[];
    };
    const pickers = new Map<string, Picker>();

    for (const node of form.querySelectorAll('[data-target-picker]')) {
      const el = node as HTMLElement;
      const select = el.querySelector('select') as HTMLSelectElement | null;
      const key = el.getAttribute('data-target-picker');
      if (!select || !key) continue;
      pickers.set(key, {
        select,
        truncated: el.getAttribute('data-truncated') === '1',
        // Snapshot before any filtering, and rebuild from it — rather than
        // hiding <option>s, which Safari ignores.
        all: Array.from(select.options)
          .filter((o) => o.value !== '')
          .map((o) => ({ value: o.value, text: o.textContent ?? '' })),
      });
    }

    // Mirrors SINGLETON_LABELS — Home and Catalog have no <option> to read a
    // name from, so their fallback is stated here too.
    const singletonLabels: Record<string, string> = { home: 'Home', catalog: 'Shop' };

    const syncPlaceholder = () => {
      if (!labelInput) return;
      const picker = pickers.get(typeSel.value);
      const name = picker
        ? (picker.select.selectedOptions[0]?.value === ''
            ? ''
            : (picker.select.selectedOptions[0]?.textContent ?? ''))
        : (singletonLabels[typeSel.value] ?? '');
      labelInput.placeholder = name ? `默认使用「${name}」` : '默认使用原名称';
    };

    const setAddEnabled = (enabled: boolean) => {
      if (!addButton) return;
      addButton.disabled = !enabled;
      if (enabled) addButton.removeAttribute('title');
      else addButton.title = '没有匹配项，请清除筛选或扩大搜索范围';
    };

    const apply = () => {
      const picker = pickers.get(typeSel.value);
      if (!picker) {
        // Home and Catalog have no target to choose, so there is always
        // something to add.
        setAddEnabled(true);
        syncPlaceholder();
        return;
      }
      const q = search.value.trim().toLowerCase();
      const matches = q ? picker.all.filter((o) => o.text.toLowerCase().includes(q)) : picker.all;
      const empty = picker.truncated ? '当前列表暂无匹配，试试搜索全部' : '暂无匹配';
      picker.select.replaceChildren(
        ...(matches.length === 0
          ? [new Option(empty, '')]
          : matches.map((o) => new Option(o.text, o.value))),
      );
      searchAll.hidden = !picker.truncated;
      setAddEnabled(matches.length > 0);
      syncPlaceholder();
    };

    typeSel.addEventListener('change', () => {
      search.value = '';
      apply();
    });
    search.addEventListener('input', apply);
    for (const picker of pickers.values()) {
      picker.select.addEventListener('change', syncPlaceholder);
    }
    // Enter in the search box would submit the form — i.e. Add. Filtering is
    // already live, so make it a no-op rather than an accidental add.
    search.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Enter') event.preventDefault();
    });
    apply();
  }

  // Up/Down without a page reload.
  //
  // Deliberately NOT a change to how saving works: each click still writes
  // immediately through the same endpoint, so there is no unsaved state to lose
  // and no dirty-state warning to write. This only skips the round trip's
  // re-render, which is what made reordering six items feel like six page loads.
  //
  // Every failure path falls back to submitting the form normally, so a network
  // error or a stale row leaves the merchant with the working no-JS behaviour
  // rather than a button that silently does nothing.
  const refreshEnds = (list: HTMLElement) => {
    const rows = [...list.children];
    rows.forEach((row, i) => {
      const up = row.querySelector('button[aria-label="上移"]') as HTMLButtonElement | null;
      const down = row.querySelector('button[aria-label="下移"]') as HTMLButtonElement | null;
      if (up) up.disabled = i === 0;
      if (down) down.disabled = i === rows.length - 1;
    });
  };

  for (const node of document.querySelectorAll('[data-menu-list]')) {
    const list = node as HTMLElement;
    const menuLocation = list.getAttribute('data-menu-list') ?? '';
    const rows = () => [...list.children] as HTMLElement[];

    /** Persist the current DOM order for this menu. */
    const persistOrder = async () => {
      const body = new URLSearchParams();
      body.set('_action', 'reorder');
      body.set('location', menuLocation);
      for (const row of rows()) body.append('order', row.getAttribute('data-menu-item') ?? '');
      try {
        const response = await fetch('/api/admin/navigation', {
          method: 'POST',
          body,
          headers: { 'x-partial': '1' },
        });
        // A failed write would leave the screen showing an order the database
        // does not have. Reload rather than lie about it.
        if (!response.ok) reloadPage();
      } catch {
        reloadPage();
      }
    };
    const reloadPage = () => window.location.reload();

    enableHandleReorder(list, async () => {
      refreshEnds(list);
      await persistOrder();
    });

    list.addEventListener('submit', async (event) => {
      const form = event.target as HTMLFormElement;
      const actionInput = form.querySelector('input[name="_action"]') as HTMLInputElement | null;
      if (actionInput?.value !== 'move') return;

      const row = form.closest('li');
      const direction = (form.querySelector('input[name="direction"]') as HTMLInputElement | null)?.value;
      const sibling =
        direction === 'up' ? row?.previousElementSibling : row?.nextElementSibling;
      if (!row || !sibling) return; // already at the end — let the server no-op it

      event.preventDefault();
      let response: Response;
      try {
        response = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
          headers: { 'x-partial': '1' },
        });
      } catch {
        form.submit();
        return;
      }
      if (!response.ok) {
        form.submit();
        return;
      }

      if (direction === 'up') list.insertBefore(row, sibling);
      else list.insertBefore(sibling, row);
      refreshEnds(list);
    });
  }
</script>
</AdminLayout>
