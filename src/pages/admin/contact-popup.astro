---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSetting, setSetting } from '../../features/settings/db';
import { CACHE_TAG } from '../../features/cache/tags';
import { purgeCacheTags } from '../../features/cache/purge';
import { popupDelays, readPopup } from '../../features/popup/settings';

let settings = readPopup((await getSetting(env.DB, 'contact_popup')) ?? undefined);
let error = '';
if (Astro.request.method === 'POST') {
  let persisted = false;
  try {
    const form = await Astro.request.formData();
    const times = [0, 1, 2, 3].map((index) => form.get('delay' + index));
    const delays = times.every((time) => typeof time === 'string' && /^\d{1,4}$/.test(time)) ? popupDelays(times.map(Number)) : null;
    const title = String(form.get('title') ?? '').trim();
    const body = String(form.get('body') ?? '').trim();
    const button = String(form.get('button') ?? '').trim();
    const dismiss = String(form.get('dismiss') ?? '').trim();
    const titleZh = String(form.get('titleZh') ?? settings.titleZh).trim();
    const bodyZh = String(form.get('bodyZh') ?? settings.bodyZh).trim();
    const buttonZh = String(form.get('buttonZh') ?? settings.buttonZh).trim();
    const dismissZh = String(form.get('dismissZh') ?? settings.dismissZh).trim();
    if (!delays) error = '请填写四个递增的时间，每项 5 至 3600 秒。';
    else if (!title || !button || !dismiss || title.length > 100 || body.length > 400 || button.length > 60 || dismiss.length > 60) {
      error = '请填写有效的英文标题、按钮文字和关闭文字。';
    } else if (!titleZh || !buttonZh || !dismissZh || titleZh.length > 100 || bodyZh.length > 400 || buttonZh.length > 60 || dismissZh.length > 60) {
      error = '请填写有效的中文标题、按钮文字和关闭文字。';
    } else {
      settings = { enabled: form.get('enabled') === '1', delays, title, body, button, dismiss, titleZh, bodyZh, buttonZh, dismissZh };
      await setSetting(env.DB, 'contact_popup', JSON.stringify(settings));
      persisted = true;
      await purgeCacheTags([CACHE_TAG.shell]);
      return Astro.redirect('/admin/contact-popup?saved=1', 303);
    }
    Astro.response.status = 400;
  } catch (cause) {
    console.error('Contact popup settings save failed', cause);
    Astro.response.status = 500;
    error = persisted ? '设置已保存，但前台缓存刷新失败。请重新保存。' : '保存失败，请重试。';
  }
}
const field = 'mt-2 block w-full rounded border border-line px-3 py-2 text-sm';
---
<AdminLayout title="智能弹窗" active="contactPopup">
  <div lang="zh-CN" class="max-w-3xl space-y-5">
    <h1 class="font-serif text-3xl">智能弹窗</h1>
    <p class="text-sm text-muted">访客停留在当前页面时按时间显示询盘弹窗。按钮使用全站 WhatsApp 号码。</p>
    {error ? <p role="alert" class="text-sm text-red-700">{error}</p> :
      Astro.url.searchParams.get('saved') === '1' && <p role="status" class="text-sm text-green-700">设置已保存。</p>}
    <form method="POST" class="space-y-4 rounded-xl border border-line bg-surface p-5">
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="enabled" value="1" checked={settings.enabled} /> 启用弹窗
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        {settings.delays.map((delay, index) => (
          <label class="text-sm">第 {index + 1} 次弹出（秒）
            <input type="number" name={'delay' + index} min="5" max="3600" step="1" value={delay} required class={field} />
          </label>
        ))}
      </div>
      <label class="block text-sm">弹窗标题（英文）
        <input name="title" maxlength="100" value={settings.title} required class={field} />
      </label>
      <label class="block text-sm">弹窗说明（英文）
        <textarea name="body" maxlength="400" rows="3" class={field}>{settings.body}</textarea>
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="text-sm">询盘按钮（英文）
          <input name="button" maxlength="60" value={settings.button} required class={field} />
        </label>
        <label class="text-sm">关闭按钮（英文）
          <input name="dismiss" maxlength="60" value={settings.dismiss} required class={field} />
        </label>
      </div>
      <label class="block text-sm">弹窗标题（简体中文）
        <input name="titleZh" maxlength="100" value={settings.titleZh} required class={field} />
      </label>
      <label class="block text-sm">弹窗说明（简体中文）
        <textarea name="bodyZh" maxlength="400" rows="3" class={field}>{settings.bodyZh}</textarea>
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="text-sm">询盘按钮（简体中文）
          <input name="buttonZh" maxlength="60" value={settings.buttonZh} required class={field} />
        </label>
        <label class="text-sm">关闭按钮（简体中文）
          <input name="dismissZh" maxlength="60" value={settings.dismissZh} required class={field} />
        </label>
      </div>
      <button type="submit" class="rounded bg-brand px-4 py-2 text-sm text-white">保存弹窗设置</button>
    </form>
  </div>
</AdminLayout>
