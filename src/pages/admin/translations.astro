---
import { parsePublicId } from '../../features/ids/publicId';

const entity = Astro.url.searchParams.get('entity');
const rawId = Astro.url.searchParams.get('id');
const kind = entity === 'product' || entity === 'category' || entity === 'page' ? entity : null;
const id = kind ? parsePublicId(rawId, kind) : null;
const section = kind === 'category' ? 'categories' : kind === 'product' ? 'products' : 'pages';
return Astro.redirect(id ? '/admin/' + section + '/' + id + '/edit' : '/admin/site-content', 303);
---
