---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../../features/categories/CategoryForm.astro';
import {
  getCategoryByPublicId,
  listCategories,
  buildTree,
  flattenTree,
  descendantIds,
} from '../../../../features/categories/db';
import { parsePublicId } from '../../../../features/ids/publicId';
import { translations } from '../../../../features/i18n/db';

// The route param is the cat_ public ID; numeric row ids are not accepted.
const publicId = parsePublicId(Astro.params.id, 'category');
const category = publicId ? await getCategoryByPublicId(env.DB, publicId) : null;

if (!category || !publicId) {
  return new Response('未找到记录。', { status: 404 });
}
const original = (await translations(env.DB, 'zh-CN', 'category', [publicId])).get(publicId);

// A category can't be moved under itself or one of its descendants — exclude them.
const blocked = new Set(await descendantIds(env.DB, category.id));
const parentOptions = flattenTree(buildTree(await listCategories(env.DB))).filter(
  (o) => !blocked.has(o.id),
);
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="编辑分类" active="categories">
  <a href="/admin/categories" class="text-sm text-gray-500 hover:text-brand">&larr; 返回分类列表</a>
  <h1 class="mt-4 mb-6 text-2xl font-bold">编辑分类</h1>
  <CategoryForm
    action={`/api/admin/categories/${category.public_id}`}
    submitLabel="保存修改"
    category={{ ...category, name: original?.title ?? category.name }}
    parentOptions={parentOptions}
    error={error}
  />
</AdminLayout>
