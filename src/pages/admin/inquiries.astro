---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getConfig } from '../../config';
import { normalizeTimeZone } from '../../features/settings/timeZone';
import { inquiryLabel, inquiryStatuses, type ContactInquiry, type InquiryStatus } from '../../features/site-content/inquiry';

const selected = Astro.url.searchParams.get('status');
const filter = selected === 'new' || selected === 'handled' ? selected : '';
const pageParam = Number(Astro.url.searchParams.get('page'));
const page = Number.isSafeInteger(pageParam) && pageParam > 0 && pageParam <= 100_000 ? pageParam : 1;
const pageSize = 25;
const pageHref = (target: number) => '/admin/inquiries?' + new URLSearchParams({ status: filter, page: String(target) });
const newStatus = (value: FormDataEntryValue | null): value is InquiryStatus => value === 'new' || value === 'handled';
const timeZone = normalizeTimeZone(Astro.locals.settings?.timeZone ?? getConfig().timeZone) ?? 'UTC';
const date = new Intl.DateTimeFormat('zh-CN', { timeZone, dateStyle: 'short', timeStyle: 'short' });
let rows: ContactInquiry[] = [];
let error = '';

if (Astro.request.method === 'POST') {
  if (Astro.request.headers.get('origin') !== Astro.url.origin) return new Response(null, { status: 403 });
  try {
    const form = await Astro.request.formData();
    const id = form.get('id');
    const status = form.get('status');
    if (typeof id !== 'string' || !/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(id) || !newStatus(status)) {
      Astro.response.status = 400;
      error = '询盘编号或处理状态无效。';
    } else {
      const update = await env.DB.prepare('UPDATE contact_inquiries SET status = ? WHERE id = ?').bind(status, id).run();
      if (update.meta.changes) return Astro.redirect(pageHref(page) + '&saved=1', 303);
      Astro.response.status = 404;
      error = '找不到这条询盘。';
    }
  } catch {
    console.error('Contact inquiry status update failed');
    Astro.response.status = 503;
    error = '更新询盘失败，请稍后再试。';
  }
}

try {
  const listing = `SELECT id, received_at AS receivedAt, name, company, email, whatsapp, country,
    business_type AS businessType, interest, estimated_quantity AS estimatedQuantity, order_type AS orderType,
    message, locale, status FROM contact_inquiries
    ${filter ? 'WHERE status = ?' : ''}
    ORDER BY received_at DESC, id DESC LIMIT ? OFFSET ?`;
  rows = (await env.DB.prepare(listing).bind(...(filter ? [filter] : []), pageSize + 1, (page - 1) * pageSize)
    .all<ContactInquiry>()).results;
} catch {
  console.error('Contact inquiries list failed');
  Astro.response.status = 503;
  error ||= '暂时无法读取询盘，请确认已应用 D1 迁移。';
}
const hasNext = rows.length > pageSize && page < 100_000;
const labelClass = 'font-semibold text-ink';
---
<AdminLayout title="询盘管理" active="inquiries">
  <section class="space-y-5">
    <header>
      <h1 class="font-serif text-3xl">询盘管理</h1>
      <p class="mt-2 text-sm text-muted">查看通过联系页提交的询盘和客户留下的联系方式。</p>
    </header>
    {error && <p role="alert" class="rounded-lg border border-line p-3 text-red-700">{error}</p>}
    {!error && Astro.url.searchParams.get('saved') === '1' &&
      <p role="status" class="text-sm font-semibold text-green-700">已更新处理状态。</p>}
    <nav aria-label="按处理状态筛选" class="flex flex-wrap gap-2">
      {[['', '全部'], ...Object.entries(inquiryStatuses)].map(([key, label]) => <a
        href={'/admin/inquiries?status=' + key} aria-current={key === filter ? 'page' : undefined}
        class:list={['rounded-md border border-line px-3 py-2 text-sm', key === filter && 'bg-brand text-white']}>{label}</a>)}
    </nav>
    {rows.slice(0, pageSize).map(row => (
      <article class="rounded-xl border border-line bg-surface p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 class="break-words text-lg font-semibold">{row.name}</h2>
            <p class="break-words text-sm text-muted">{[row.company, row.country, date.format(row.receivedAt * 1000)].filter(Boolean).join(' · ')}</p>
          </div>
          <form method="POST" action={pageHref(page)} class="flex flex-wrap items-center gap-2">
            <input type="hidden" name="id" value={row.id} />
            <label class="text-sm">状态
              <select name="status" class="ml-1 rounded border border-line bg-paper p-2">
                {Object.entries(inquiryStatuses).map(([key, label]) => <option value={key} selected={row.status === key}>{label}</option>)}
              </select>
            </label>
            <button class="rounded-md bg-brand px-3 py-2 text-sm font-semibold text-white">更新状态</button>
          </form>
        </div>
        <dl class="mt-4 grid gap-3 break-words border-t border-line pt-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
          {row.email && <div><dt class={labelClass}>邮箱</dt><dd><a class="break-all underline" href={'mailto:' + encodeURIComponent(row.email).replace('%40', '@')}>{row.email}</a></dd></div>}
          {row.whatsapp && <div><dt class={labelClass}>WhatsApp / 电话</dt><dd>{row.whatsapp}</dd></div>}
          <div><dt class={labelClass}>客户类型</dt><dd>{inquiryLabel('businessType', row.businessType)}</dd></div>
          <div><dt class={labelClass}>意向产品</dt><dd>{inquiryLabel('interest', row.interest)}</dd></div>
          <div><dt class={labelClass}>预计采购数量</dt><dd>{inquiryLabel('estimatedQuantity', row.estimatedQuantity)}</dd></div>
          <div><dt class={labelClass}>订单类型</dt><dd>{inquiryLabel('orderType', row.orderType)}</dd></div>
          <div><dt class={labelClass}>提交语言</dt><dd>{row.locale === 'zh-CN' ? '简体中文' : '英文'}</dd></div>
          {row.message && <div class="sm:col-span-2 lg:col-span-3"><dt class={labelClass}>留言</dt><dd class="whitespace-pre-wrap">{row.message}</dd></div>}
        </dl>
      </article>
    ))}
    {!rows.length && !error && <p class="rounded-lg border border-line p-4 text-sm text-muted">当前没有询盘。</p>}
    {(page > 1 || hasNext) && <nav aria-label="询盘分页" class="flex flex-wrap items-center gap-4 text-sm">
      {page > 1 && <a class="underline" href={pageHref(page - 1)}>上一页</a>}
      <span>第 {page} 页</span>
      {hasNext && <a class="underline" href={pageHref(page + 1)}>下一页</a>}
    </nav>}
  </section>
</AdminLayout>
