---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  getCategoryBySlug,
  ancestors,
  listCategories,
  childrenOf,
  productsInCategory,
  countProductsInCategory,
} from '../../features/categories/db';
import { readSiteCopy } from '../../features/site-content/copy';
import { display } from '../../features/i18n/locale';
import { localizedProduct, translations } from '../../features/i18n/db';
import ProductCard from '#theme/ProductCard.astro';
import Catalog from '#theme/Catalog.astro';
import { buildProductCard } from '../../features/storefront/productCard';
import { getConfig } from '../../config';
import { orderByClause, parseStoreSortQuery } from '../../features/products/sort';
import {
  MAX_PUBLIC_PAGE,
  paginate,
  queryHref,
} from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import { buildPaginationModel, buildSortModel } from '../../features/storefront/catalog';
import { catalogPath } from '../../features/settings/home';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';

const { slug } = Astro.params;
const locale = Astro.locals.storeLocale;
const category = slug ? await getCategoryBySlug(env.DB, slug) : null;

if (!category) {
  return new Response('Not found', { status: 404 });
}

const { sort, dir } = parseStoreSortQuery(
  Astro.url.searchParams.get('sort'),
  Astro.url.searchParams.get('dir'),
);
const order = orderByClause(sort, dir);

const PAGE_SIZE = 24;
const [trail, categories, total] = await Promise.all([
  ancestors(env.DB, category.id),
  listCategories(env.DB),
  countProductsInCategory(env.DB, category.id),
]);
const subcats = childrenOf(categories, category.id);
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  total,
  PAGE_SIZE,
  MAX_PUBLIC_PAGE,
);
const products = await productsInCategory(env.DB, category.id, PAGE_SIZE, offset, order);
const [categoryText, productText] = await Promise.all([
  translations(env.DB, locale, 'category', categories.map((item) => item.public_id)),
  translations(env.DB, locale, 'product', products.map((item) => item.public_id)),
]);
const categoriesById = new Map(categories.map((item) => [item.id, item]));
const categoryName = (item: { id: number; name: string }) =>
  categoryText.get(categoriesById.get(item.id)?.public_id ?? '')?.title ?? item.name;
addCacheTags(Astro.response.headers, productCacheTags(products.map((product) => product.public_id)));
// Presentation models are built here, where the store's image settings are
// known; only the first card is the LCP image.
const cards = products.map((product, i) =>
  buildProductCard(localizedProduct(product, productText.get(product.public_id ?? '')), {
    baseUrl: getConfig().images.baseUrl,
    currency: getConfig().currency,
    delivery: Astro.locals.settings?.imageDelivery,
    sizes: '(min-width: 1024px) 352px, calc(50vw - 36px)',
    priority: i === 0,
  }),
);
const base = `/categories/${category.slug}`;
const hrefFor = (p: number) =>
  queryHref(base, {
    sort: sort === 'newest' ? undefined : sort,
    dir: dir === 'desc' ? undefined : dir,
    page: p > 1 ? p : undefined,
  });
// The catalog is at / until the home page is pointed elsewhere.
const teal = import.meta.env.MINSHOP_THEME === 'teal';
const shopHref = catalogPath(Astro.locals.settings?.homePage);
const sortModel = buildSortModel(base, sort, dir);
const categoryTabs = [...new Map([...childrenOf(categories, category.parent_id), ...subcats]
  .map(item => [item.id, {text: categoryName(item), href: '/categories/' + item.slug}])).values()];
---

<Layout title={categoryName(category)}>
  {teal ? <Catalog model={{ locale, eyebrow: '', heading: categoryName(category), categoryPage: base,
    categories: categoryTabs, products: cards, sort: sortModel,
    copy: readSiteCopy(Astro.locals.settings?.siteContent, 'products', locale ?? 'en'),
    pagination: buildPaginationModel(base, page, totalPages, sort, dir) }} /> : <>
  <nav class="mb-4 flex flex-wrap gap-x-2 text-xs uppercase tracking-widest text-faint">
    <a href={shopHref} class="hover:text-brand">{display(locale, 'Shop', '商城')}</a>
    {
      trail.map((c) => (
        <span class="flex gap-x-2">
          <span aria-hidden="true">/</span>
          <a href={`/categories/${c.slug}`} class="hover:text-brand">
            {categoryName(c)}
          </a>
        </span>
      ))
    }
  </nav>

  <h1 class="mb-8 font-serif text-4xl tracking-tight sm:text-5xl">{categoryName(category)}</h1>

  {
    subcats.length > 0 && (
      <div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest text-muted">
        {subcats.map((c) => (
          <a
            href={`/categories/${c.slug}`}
            class="border-b border-transparent pb-0.5 hover:border-brand hover:text-brand"
          >
            {categoryName(c)}
          </a>
        ))}
      </div>
    )
  }

  <CatalogSort locale={locale} model={sortModel} />

  {products.length === 0 && <p class="text-muted">No products in this category yet.</p>}

  <ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-3">
    {
      cards.map((card, i) => (
        <ProductCard card={card} index={i} />
      ))
    }
  </ul>

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
  </>}
</Layout>
